<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<Meta name="ExplicitAutoJoints">true</Meta>
<External>null</External>
<External>nil</External>
	<Item class="Folder" referent="RBX1f31ba2e9ac54759">
		<Properties>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<string name="Name">Kite</string>
			<int64 name="SourceAssetId">-1</int64>
			<BinaryString name="Tags"></BinaryString>
		</Properties>
		<Item class="Folder" referent="RBX583574d205e2416a">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<string name="Name">Benchmarks</string>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
			<Item class="LocalScript" referent="RBXf44e4f67b6635055">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">BenchmarksVSvide</string>
					<ProtectedString name="Source">--!strict
		--[=[
			--&gt; ["Kite : Benchmarks"]
		
			Numbers, not adjectives.
		
			Every benchmark here runs two things:
		
				kite     the package
				baseline the way you would write it by hand, which is roughly what a
				         non compiled, non keyed, non batched reactive layer costs
		
			The baseline is in this file so you can read it and argue with it. It is
			not a strawman: it builds instances, sets properties, and wires
			RBXScriptConnections the way most hand written UI code does.
		
			--&gt; ["how to read the table"]
			```text
			bench                       kite        baseline    x
			mount 1000 rows             3.1 ms      8.4 ms      2.7
			```
			`x` is baseline divided by kite. Higher is better for Kite.
		
			--&gt; ["run it"]
			LocalScript in StarterPlayerScripts, then read the output window.
			Frame time is measured on your machine, in Studio, with your plugins, so
			treat the ratios as the signal and the milliseconds as a mood.
		]=]
		
		local Kite = require(game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("Kite"))
		
		local ROWS = 1000
		local WRITES = 10000
		local SHUFFLES = 40
		
		type Result = {
			name: string,
			kite: number,
			baseline: number,
		}
		
		local results: { Result } = {}
		
		--&gt; ["harness"]
		
		local function time(name: string, kite: () -&gt; any, baseline: () -&gt; any): Result
			Kite.profiler():reset()
		
			local started = os.clock()
			kite()
			local kiteTook = os.clock() - started
		
			-- let the engine breathe so the second run is not measuring garbage
			task.wait()
		
			started = os.clock()
			baseline()
			local baselineTook = os.clock() - started
		
			task.wait()
		
			local result = {
				name = name,
				kite = kiteTook * 1000,
				baseline = baselineTook * 1000,
			}
		
			table.insert(results, result)
			return result
		end
		
		local function rowOf(rows: number): { [string]: any }
			return {
				id = `row{rows}`,
				name = `Row {rows}`,
				value = rows,
			}
		end
		
		local function makeData(count: number): { [string]: any }
			local data = {}
			for index = 1, count do
				table.insert(data, rowOf(index))
			end
			return data
		end
		
		local function host(): Instance
			local screen = Instance.new("ScreenGui")
			screen.Name = "BenchHost"
			screen.Enabled = false
			return screen
		end
		
		--&gt; ["1] mount a big list"]
		
		local function benchMount()
			local data = makeData(ROWS)
		
			time("mount 1000 rows", function()
				-- Kite: compile once, then mount
				local rows = Kite.source(data)
				local tree = Kite.create("Frame", {
					Name = "List",
					Size = UDim2.fromScale(1, 1),
					Kite.children({
						Kite.create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
						Kite.keys(function()
							return rows()
						end, function(item, index)
							return Kite.create("TextLabel", {
								Name = function()
									return item().id
								end,
								Size = UDim2.new(1, 0, 0, 24),
								Text = function()
									return item().name
								end,
								TextColor3 = function()
									return if index() % 2 == 0 then Color3.new(1, 1, 1) else Color3.new(0.7, 0.7, 0.7)
								end,
								TextSize = 14,
							})
						end, function(item)
							return item.id
						end),
					}),
				})
		
				local parent = host()
				local handle = Kite.mount(tree, parent)
				handle:destroy()
				parent:Destroy()
			end, function()
				-- baseline: build it by hand and wire it by hand
				local parent = host()
				local list = Instance.new("Frame")
				list.Name = "List"
				list.Size = UDim2.fromScale(1, 1)
				list.Parent = parent
		
				local layout = Instance.new("UIListLayout")
				layout.SortOrder = Enum.SortOrder.LayoutOrder
				layout.Parent = list
		
				for _, item in data do
					local label = Instance.new("TextLabel")
					label.Name = item.id
					label.Size = UDim2.new(1, 0, 0, 24)
					label.Text = item.name
					label.TextColor3 = Color3.new(1, 1, 1)
					label.TextSize = 14
					label.Parent = list
				end
		
				parent:Destroy()
			end)
		end
		
		--&gt; ["2] reactive writes"]
		
		local function benchWrites()
			time(`${WRITES} source writes`, function()
				-- Kite: one source, one effect, batched
				local value = Kite.source(0)
				local seen = 0
				local sink = seen
		
				Kite.effect(function()
					sink = value()
				end)
		
				Kite.batch(function()
					for index = 1, WRITES do
						value(index)
					end
				end)
		
				local handle = sink
				handle = handle
			end, function()
				-- baseline: a function call per write, no batching, no graph
				local value = 0
				local sink = 0
		
				local function set(next: number)
					value = next
					sink = value
				end
		
				for index = 1, WRITES do
					set(index)
				end
			end)
		end
		
		--&gt; ["3] deep derive chain"]
		
		local function benchChain()
			time("1000 derives, 100 reads", function()
				local root = Kite.source(0)
				local cursor: any = root
		
				for _ = 1, 1000 do
					local inner = cursor
					cursor = Kite.derive(function()
						return inner() + 1
					end)
				end
		
				for index = 1, 100 do
					root(index)
					cursor()
				end
			end, function()
				-- baseline: recompute the chain by hand on every read
				local root = 0
		
				local function compute(): number
					local value = root
					for _ = 1, 1000 do
						value += 1
					end
					return value
				end
		
				for index = 1, 100 do
					root = index
					compute()
				end
			end)
		end
		
		--&gt; ["4] keyed reconciliation"]
		
		local function benchReconcile()
			local data = makeData(500)
		
			time("shuffle 500 rows x40", function()
				-- Kite: rows are matched by id, so a shuffle writes LayoutOrder
				local rows = Kite.source(data)
		
				local tree = Kite.create("Frame", {
					Name = "List",
					Kite.children({
						Kite.create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
						Kite.keys(function()
							return rows()
						end, function(item, index)
							return Kite.create("TextLabel", {
								Name = function()
									return item().id
								end,
								Text = function()
									return item().name
								end,
								LayoutOrder = index,
								TextSize = 14,
							})
						end, function(item)
							return item.id
						end),
					}),
				})
		
				local parent = host()
				local handle = Kite.mount(tree, parent)
		
				for turn = 1, SHUFFLES do
					local next = table.clone(rows())
					local moved = table.remove(next, 1)
					table.insert(next, moved)
					rows(next)
				end
		
				handle:destroy()
				parent:Destroy()
			end, function()
				-- baseline: rebuild the list on every change
				local parent = host()
				local list = Instance.new("Frame")
				list.Name = "List"
				list.Parent = parent
		
				local layout = Instance.new("UIListLayout")
				layout.SortOrder = Enum.SortOrder.LayoutOrder
				layout.Parent = list
		
				local current = data
		
				local function rebuild(rows: { [string]: any })
					list:ClearAllChildren()
		
					local fresh = Instance.new("UIListLayout")
					fresh.SortOrder = Enum.SortOrder.LayoutOrder
					fresh.Parent = list
		
					for index, item in rows do
						local label = Instance.new("TextLabel")
						label.Name = item.id
						label.Text = item.name
						label.LayoutOrder = index
						label.TextSize = 14
						label.Parent = list
					end
				end
		
				rebuild(current)
		
				for turn = 1, SHUFFLES do
					local next = table.clone(current)
					local moved = table.remove(next, 1)
					table.insert(next, moved)
					current = next
					rebuild(current)
				end
		
				parent:Destroy()
			end)
		end
		
		--&gt; ["5] mount the same compiled tree twice"]
		
		local function benchCompile()
			local tree = Kite.create("Frame", {
				Name = "Row",
				Size = UDim2.new(1, 0, 0, 24),
				Kite.children({
					Kite.create("UICorner", { CornerRadius = UDim.new(0, 6) }),
					Kite.create("UIPadding", { PaddingLeft = UDim.new(0, 12) }),
					Kite.create("TextLabel", {
						Name = "Label",
						Size = UDim2.new(1, 0, 1, 0),
						Text = "row",
						TextSize = 14,
					}),
				}),
			})
		
			time("mount a cached plan 200x", function()
				Kite.compile(tree)
				local parent = host()
		
				for _ = 1, 200 do
					local handle = Kite.mount(tree, parent)
					handle:destroy()
				end
		
				parent:Destroy()
			end, function()
				local parent = host()
		
				for _ = 1, 200 do
					-- baseline: describe the row again every single time
					local row = Instance.new("Frame")
					row.Name = "Row"
					row.Size = UDim2.new(1, 0, 0, 24)
		
					local corner = Instance.new("UICorner")
					corner.CornerRadius = UDim.new(0, 6)
					corner.Parent = row
		
					local padding = Instance.new("UIPadding")
					padding.PaddingLeft = UDim.new(0, 12)
					padding.Parent = row
		
					local label = Instance.new("TextLabel")
					label.Name = "Label"
					label.Size = UDim2.new(1, 0, 1, 0)
					label.Text = "row"
					label.TextSize = 14
					label.Parent = row
		
					row.Parent = parent
					row:Destroy()
				end
		
				parent:Destroy()
			end)
		end
		
		--&gt; ["6] motion"]
		
		local function benchMotion()
			time("600 spring frames", function()
				local value = Kite.source(0)
				local moved = Kite.spring(value, 1)
				value(100)
		
				-- the driver is stepped by RunService in Studio, so this measures
				-- the maths and the writes, not the frame itself
				for frame = 1, 600 do
					moved()
				end
			end, function()
				-- baseline: the same spring maths, written inline, per property
				local value = 0
				local target = 100
				local velocity = 0
		
				for frame = 1, 600 do
					local delta = 1 / 60
					local omega = (2 * math.pi) * 1
					local f = 1 + 2 * delta * omega
					local oo = omega * omega
					local hoo = delta * oo
					local hhoo = delta * hoo
					local inverse = 1 / (f + hhoo)
					local displacement = value - target
					local nextValue = (f * value + delta * velocity + hhoo * target) * inverse
					velocity = (velocity + hoo * -displacement) * inverse
					value = nextValue
				end
			end)
		end
		
		--&gt; ["run"]
		
		local function report()
			local lines = {}
		
			table.insert(lines, "")
			table.insert(lines, `  Kite {Kite.VERSION} benchmarks`)
			table.insert(lines, `  mode {Kite.modeOf()} · {ROWS} rows · {WRITES} writes · {SHUFFLES} shuffles`)
			table.insert(lines, "")
			table.insert(lines, `  {Kite.title("benchmark")}`)
		
			local function pad(text: string, width: number): string
				if #text &gt;= width then
					return text
				end
				return text .. string.rep(" ", width - #text)
			end
		
			table.insert(lines, `  {pad("benchmark", 30)}{pad("kite", 12)}{pad("baseline", 12)}faster`)
			table.insert(lines, `  {string.rep("-", 66)}`)
		
			for _, entry in results do
				local ratio = if entry.kite &gt; 0 then entry.baseline / entry.kite else 0
				table.insert(
					lines,
					`  {pad(entry.name, 30)}{pad(`{string.format("%.2f", entry.kite)} ms`, 12)}{pad(`{string.format("%.2f", entry.baseline)} ms`, 12)}{string.format("%.2fx", ratio)}`
				)
			end
		
			table.insert(lines, "")
			table.insert(lines, "  counters from the last pass")
			table.insert(lines, "")
			table.insert(lines, Kite.profiler():text())
			table.insert(lines, "")
		
			return table.concat(lines, "\n")
		end
		
		Kite.mode("performance")
		
		benchMount()
		benchWrites()
		benchChain()
		benchReconcile()
		benchCompile()
		benchMotion()
		
		print(report())
		
		return results
		</ProtectedString>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX7972c2584ce280a8">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<string name="Name">Core</string>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
			<Item class="ModuleScript" referent="RBX69f8642a8f619040">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Compiler</string>
					<ProtectedString name="Source">--!strict
		--[=[
			--&gt; ["Kite : Compiler"]
		
			A Kite tree is a plain table. The compiler turns that table into a plan:
			static properties in one flat array, dynamic properties in another,
			events, attributes, tags, refs, and children already resolved.
		
			Mounting then walks the plan with no string compares, no type checks,
			and no decisions left to make.
		
				author once  -&gt;  kite.compile(tree)
				mount many   -&gt;  the same plan, reused
		
			Plans are cached weakly against the tree table, so the second mount of
			the same tree is a table lookup, not another walk.
		]=]
		
		local Util = require(script.Parent.Util)
		local Types = require(script.Parent.Types)
		local Config = require(script.Parent.Config)
		
		export type Plan = {
			kind: string,
			class: string?,
			name: string?,
			statics: { { [number]: any } }?,
			dynamics: { { [number]: any } }?,
			events: { { [number]: any } }?,
			attrs: { [string]: any }?,
			tags: { string }?,
			refs: { any }?,
			effects: { any }?,
			children: { any }?,
			feed: any?,
			key: any?,
			node: any?,
		}
		
		local Compiler = {}
		
		Compiler.compiled = 0 :: number
		Compiler.cacheHits = 0 :: number
		Compiler.sugar = 0 :: number
		
		local cache = (setmetatable({}, { __mode = "k" }) :: any) :: { [any]: Plan }
		
		--&gt; ["markers"]
		-- Special keys are frozen tables, so they can never collide with a real
		-- Roblox property name.
		
		local markers = {}
		Compiler.markers = markers
		
		local function marker(name: string)
			local value = table.freeze(setmetatable({ __special = name }, {
				__type = "Kite.Special",
				__tostring = function()
					return `kite.{name}`
				end,
				__call = function(_self: any, payload: any)
					return { kind = "special", name = name, value = payload }
				end,
			}))
		
			markers[name] = value
			return value
		end
		
		marker("on")
		marker("ref")
		marker("attr")
		marker("tags")
		marker("children")
		marker("live")
		marker("key")
		marker("bind")
		
		local function markerOf(value: any): string?
			if type(value) ~= "table" then
				return nil
			end
		
			local meta = getmetatable(value)
			if type(meta) == "table" and (meta :: any).__type == "Kite.Special" then
				return (value :: any).__special
			end
		
			return nil
		end
		
		Compiler.markerOf = markerOf
		
		local function callable(value: any): boolean
			if type(value) == "function" then
				return true
			end
		
			if type(value) ~= "table" then
				return false
			end
		
			local meta = getmetatable(value)
		
			if type(meta) == "table" then
				if type((meta :: any).__call) == "function" then
					return true
				end
				if (meta :: any).__type == "Kite.Source" then
					return true
				end
				if (meta :: any).__type == "Kite.Motion" then
					return true
				end
			end
		
			return false
		end
		
		Compiler.callable = callable
		
		--&gt; ["sugar"]
		-- Creative and performance modes take shorthands. Strict mode refuses them
		-- and hands you the long form.
		
		local function childOf(class: string, props: { [string]: any }): Plan
			return Compiler.plan({
				kind = "element",
				class = class,
				props = props,
			} :: any)
		end
		
		local function pushSugar(plan: Plan, key: string, value: any, children: { any })
			Compiler.sugar += 1
		
			if key == "padding" then
				local top, right, bottom, left
				if typeof(value) == "number" then
					top, right, bottom, left = value, value, value, value
				elseif typeof(value) == "UDim" then
					top, right, bottom, left = value, value, value, value
				elseif typeof(value) == "table" then
					local entry = value :: any
					if entry[1] ~= nil and entry[2] ~= nil and entry[3] == nil then
						top, bottom = entry[1], entry[1]
						left, right = entry[2], entry[2]
					elseif entry[1] ~= nil then
						top, right, bottom, left = entry[1], entry[2] or entry[1], entry[3] or entry[1], entry[4] or entry[2] or entry[1]
					else
						top = entry.top or entry.Top or 0
						right = entry.right or entry.Right or 0
						bottom = entry.bottom or entry.Bottom or 0
						left = entry.left or entry.Left or 0
					end
				end
		
				table.insert(children, childOf("UIPadding", {
					PaddingTop = Util.padding(top or 0),
					PaddingRight = Util.padding(right or 0),
					PaddingBottom = Util.padding(bottom or 0),
					PaddingLeft = Util.padding(left or 0),
				}))
				return
			end
		
			if key == "corner" then
				table.insert(children, childOf("UICorner", { CornerRadius = Util.padding(value) }))
				return
			end
		
			if key == "stroke" then
				if typeof(value) == "Color3" or typeof(value) == "string" then
					table.insert(children, childOf("UIStroke", { Color = Util.hex(value) }))
				else
					local entry = value :: any
					table.insert(children, childOf("UIStroke", {
						Color = Util.hex(entry.color or entry.Color or entry[1] or "#ffffff"),
						Thickness = entry.thickness or entry.Thickness or entry[2] or 1,
						Transparency = entry.transparency or entry.Transparency or entry[3] or 0,
					}))
				end
				return
			end
		
			if key == "gradient" then
				local entry = value :: any
				local colors = entry.colors or entry.Colors or entry
				local rotation = entry.rotation or entry.Rotation or 90
		
				local points = {}
				local total = math.max(1, #colors - 1)
		
				for index, color in colors do
					table.insert(points, ColorSequenceKeypoint.new((index - 1) / total, Util.hex(color)))
				end
		
				if #points == 1 then
					table.insert(points, ColorSequenceKeypoint.new(1, Util.hex(colors[1])))
				end
		
				table.insert(children, childOf("UIGradient", {
					Color = ColorSequence.new(points),
					Rotation = rotation,
				}))
				return
			end
		
			if key == "list" then
				local entry = value :: any
		
				if typeof(entry) == "string" then
					table.insert(children, childOf("UIListLayout", {
						FillDirection = if entry == "horizontal" then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
						SortOrder = Enum.SortOrder.LayoutOrder,
					}))
				else
					local props = {}
					for propKey, propValue in entry do
						props[Util.title(propKey)] = propValue
					end
					if props.SortOrder == nil then
						props.SortOrder = Enum.SortOrder.LayoutOrder
					end
					table.insert(children, childOf("UIListLayout", props))
				end
				return
			end
		
			if key == "scale" then
				table.insert(children, childOf("UIScale", { Scale = value }))
				return
			end
		
			if key == "aspect" then
				table.insert(children, childOf("UIAspectRatioConstraint", { AspectRatio = value }))
				return
			end
		end
		
		local SUGAR = table.freeze({
			size = "Size",
			position = "Position",
			anchor = "AnchorPoint",
			color = "BackgroundColor3",
			textColor = "TextColor3",
			strokeColor = "Color",
			rotate = "Rotation",
			zindex = "ZIndex",
			clip = "ClipsDescendants",
			textSize = "TextSize",
			font = "FontFace",
		})
		
		local SUGAR_CHILD = table.freeze({
			padding = "UIPadding",
			corner = "UICorner",
			stroke = "UIStroke",
			gradient = "UIGradient",
			list = "UIListLayout",
			scale = "UIScale",
			aspect = "UIAspectRatioConstraint",
		})
		
		local function sugarProperty(key: string, value: any): any
			if key == "size" or key == "position" then
				return Util.size(value)
			end
		
			if key == "anchor" then
				if typeof(value) == "number" then
					return Vector2.new(value, value)
				end
				if typeof(value) == "string" then
					if value == "center" then
						return Vector2.new(0.5, 0.5)
					end
					if value == "top" then
						return Vector2.new(0.5, 0)
					end
					if value == "bottom" then
						return Vector2.new(0.5, 1)
					end
					if value == "left" then
						return Vector2.new(0, 0.5)
					end
					if value == "right" then
						return Vector2.new(1, 0.5)
					end
				end
				if typeof(value) == "table" then
					return Vector2.new((value :: any)[1] or (value :: any).x or 0, (value :: any)[2] or (value :: any).y or 0)
				end
				return value
			end
		
			if key == "color" or key == "textColor" or key == "strokeColor" then
				return Util.hex(value)
			end
		
			if key == "font" then
				if typeof(value) == "string" then
					return Font.fromName(value, Enum.FontWeight.Regular, Enum.FontStyle.Normal)
				end
				if typeof(value) == "table" then
					local entry = value :: any
					return Font.new(entry[1], entry[2] or Enum.FontWeight.Regular, entry[3] or Enum.FontStyle.Normal)
				end
				return value
			end
		
			return value
		end
		
		--&gt; ["plan"]
		
		local function planElement(element: any, report: { any }?): Plan
			local class = element.class :: string
			local props = element.props or {}
		
			local plan: Plan = {
				kind = "element",
				class = class,
				name = nil,
				statics = nil,
				dynamics = nil,
				events = nil,
				attrs = nil,
				tags = nil,
				refs = nil,
				effects = nil,
				children = nil,
				feed = nil,
				key = nil,
				node = nil,
			}
		
			local statics: { { [number]: any } } = {}
			local dynamics: { { [number]: any } } = {}
			local events: { { [number]: any } } = {}
			local children: { any } = {}
			local validate = Config.validate
		
			--&gt; ["special keys"]
			-- Specials arrive two ways, and both are valid:
			--   [kite.ref] = box        computed key, the classic shape
			--   kite.ref(box)           callable, reads better in a list of children
		
			local function applySpecial(name: string, value: any)
				if name == "on" then
					for eventName, handler in value do
						table.insert(events, { eventName, handler })
					end
				elseif name == "attr" then
					plan.attrs = value
				elseif name == "tags" then
					plan.tags = value
				elseif name == "ref" then
					local refs = plan.refs or {}
					table.insert(refs, value)
					plan.refs = refs
				elseif name == "live" then
					local effects = plan.effects or {}
					table.insert(effects, value)
					plan.effects = effects
				elseif name == "key" then
					plan.key = value
				elseif name == "bind" then
					for propKey, fn in value do
						table.insert(dynamics, { propKey, fn })
					end
				elseif name == "children" then
					if type(value) == "table" then
						for _, child in value do
							table.insert(children, Compiler.plan(child))
						end
					else
						table.insert(children, Compiler.plan(value))
					end
				end
			end
		
			for key, value in props do
				local special = markerOf(key)
		
				if special then
					applySpecial(special, value)
					continue
				end
		
				if type(key) == "number" then
					if type(value) == "table" and (value :: any).kind == "special" then
						applySpecial((value :: any).name, (value :: any).value)
					elseif callable(value) then
						table.insert(children, Compiler.plan({ kind = "dynamic", render = value }))
					else
						table.insert(children, Compiler.plan(value))
					end
					continue
				end
		
				if type(key) ~= "string" then
					continue
				end
		
				local mapped = (SUGAR :: any)[key]
				local childSugar = (SUGAR_CHILD :: any)[key]
		
				if (mapped or childSugar) and not Config.sugar then
					if report then
						local long = if mapped then `{mapped} = ...` else `a {SUGAR_CHILD[key]} child`
						table.insert(report, {
							key = key,
							message = `"{key}" is Kite sugar and strict mode refuses sugar`,
							hint = `write it long form: {long}. switch modes with kite.mode "creative"`,
							level = "error",
						})
					end
					continue
				end
		
				if childSugar then
					pushSugar(plan, key, value, children)
					continue
				end
		
				if mapped then
					local sugarKey = key
					key = mapped
					value = sugarProperty(sugarKey, value)
				end
		
				-- events come first: a handler is a function, but it is not a binding
				if type(value) == "function" and Types.isEvent(class, key) then
					table.insert(events, { key, value })
					continue
				end
		
				if callable(value) then
					table.insert(dynamics, { key, value })
					continue
				end
		
				if key == "Name" then
					plan.name = value
				end
		
				if validate then
					local ok, coerced, problem = Types.check(class, key, value, Config.mode == "strict")
		
					if not ok and problem then
						if report then
							table.insert(report, problem)
						end
						if problem.level == "error" and Config.guard then
							continue
						end
					else
						table.insert(statics, { key, coerced })
						continue
					end
				end
		
				table.insert(statics, { key, value })
			end
		
			if #statics &gt; 0 then
				plan.statics = statics
			end
		
			plan.dynamics = if #dynamics &gt; 0 then dynamics else nil
			plan.events = if #events &gt; 0 then events else nil
			plan.children = if #children &gt; 0 then children else nil
		
			return plan
		end
		
		function Compiler.plan(node: any, report: { any }?): Plan
			if node == nil then
				return nil :: any
			end
		
			local kind = type(node) == "table" and (node :: any).kind or nil
		
			if kind == nil then
				if typeof(node) == "Instance" then
					return {
						kind = "instance",
						node = node,
					} :: Plan
				end
		
				error(
					`[Kite] a child in your tree is {Util.show(node)}, which is not something Kite can mount.\n`
						.. "  children are elements (kite.create \"Frame\" { ... }), instances, or dynamic nodes.",
					3
				)
			end
		
			if kind == "element" then
				local hit = cache[node]
				if hit and Config.cache then
					Compiler.cacheHits += 1
					return hit
				end
		
				local plan = planElement(node, report)
				Compiler.compiled += 1
				Util.freeze(plan)
		
				if Config.cache then
					cache[node] = plan
				end
		
				return plan
			end
		
			-- dynamic nodes (keys, indexes, when, switch, component, instance, motion)
			local plan: Plan = {
				kind = kind,
				class = nil,
				name = nil,
				statics = nil,
				dynamics = nil,
				events = nil,
				attrs = nil,
				tags = nil,
				refs = nil,
				effects = nil,
				children = nil,
				feed = node.feed,
				key = node.key,
				node = if kind == "instance" then (node :: any).node else node,
			}
		
			return plan
		end
		
		function Compiler.compile(node: any): Plan
			return Compiler.plan(node)
		end
		
		function Compiler.forget()
			table.clear(cache)
		end
		
		function Compiler.stats()
			return {
				compiled = Compiler.compiled,
				cacheHits = Compiler.cacheHits,
				cached = Util.count(cache),
				sugar = Compiler.sugar,
			}
		end
		
		function Compiler.reset()
			Compiler.compiled = 0
			Compiler.cacheHits = 0
			Compiler.sugar = 0
		end
		
		return Compiler
		</ProtectedString>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXb750cbf6cf84d4d6">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Component</string>
					<ProtectedString name="Source">--!strict
		--[=[
			--&gt; ["Kite : Component"]
		
			A component is a function that returns an element, plus a contract that
			says what it accepts.
		
			The contract is what makes components *guide* you. Spell a prop wrong
			and Kite names the component, the prop, and the shape it wanted:
		
				```lua
				local Card = kite.component(`Card`, function(props)
					return kite.create `Frame` { Size = props.size }
				end, {
					size = { type = `UDim2`, default = UDim2.fromOffset(200, 120) },
					title = { type = `string`, required = true },
				})
		
				Card { titel = `hello` }
				-- [Kite] Card does not take a prop called `titel`. did you mean `title`?
				--   Card { title = `hello`, size = UDim2.fromOffset(200, 120) }
				```
		
			Props that are sources or functions stay reactive. Props that are plain
			values are checked once and passed straight through.
		]=]
		
		local Util = require(script.Parent.Util)
		local Config = require(script.Parent.Config)
		
		export type Field = {
			type: string?,
			default: any?,
			required: boolean?,
			note: string?,
		}
		
		export type Component = {
			kind: string,
			name: string,
			build: (any) -&gt; any,
			fields: { [string]: Field },
		}
		
		local Component = {}
		
		Component.defined = 0 :: number
		Component.built = 0 :: number
		
		local registry: { [string]: Component } = {}
		Component.registry = registry
		
		--&gt; ["define"]
		
		function Component.define(name: string, build: (any) -&gt; any, fields: { [string]: Field }?): Component
			if type(name) ~= "string" then
				error("[Kite] kite.component(name, build) needs a name string first.", 2)
			end
		
			if type(build) ~= "function" then
				error(`[Kite] component "{name}" needs a build function, got {Util.show(build)}.`, 2)
			end
		
			local definition: Component = {
				kind = "component",
				name = name,
				build = build,
				fields = fields or {},
			}
		
			registry[name] = definition
			Component.defined += 1
		
			local function call(props: { [any]: any }?): any
				Component.built += 1
				local resolved = Component.resolve(definition, props or {})
				return {
					kind = "component",
					name = name,
					props = resolved,
					definition = definition,
				}
			end
		
			return setmetatable(definition, {
				__type = "Kite.Component",
				__call = function(_self: any, props: { [any]: any }?)
					return call(props)
				end,
				__tostring = function(_self: any)
					return `Kite.Component({name})`
				end,
				__index = definition,
			}) :: any
		end
		
		Component.create = Component.define
		Component.component = Component.define
		
		--&gt; ["resolve"]
		-- Applies defaults, checks types, and reports in the language of the
		-- component, not the language of Luau.
		
		function Component.resolve(definition: Component, props: { [any]: any }): { [any]: any }
			local fields = definition.fields
			local out = {}
		
			if Config.validate then
				for key in props do
					if type(key) == "string" and fields[key] == nil then
						local nearest = Util.nearest(key, Util.keys(fields))
		
						local shape = {}
						for fieldName, field in fields do
							table.insert(shape, `{fieldName} = {Util.show(field.default)}`)
						end
						table.sort(shape)
		
						error(
							`[Kite] {definition.name} does not take a prop called "{key}".\n`
								.. (if nearest then `  did you mean "{nearest}"?\n` else "")
								.. `  {definition.name} takes: {table.concat(shape, ", ")}`,
							3
						)
					end
				end
			end
		
			for key, field in fields do
				local value = props[key]
		
				if value == nil then
					if field.required then
						error(
							`[Kite] {definition.name} needs "{key}" and you did not pass it.\n`
								.. `  {definition.name} ({key} = &lt;{field.type or "value"}&gt;)`,
							3
						)
					end
		
					if field.default ~= nil then
						out[key] = field.default
					end
		
					continue
				end
		
				out[key] = value
			end
		
			for key, value in props do
				if out[key] == nil then
					out[key] = value
				end
			end
		
			return out
		end
		
		--&gt; ["mount"]
		-- Components are not instances, so the mounter calls the builder and
		-- mounts whatever comes back.
		
		function Component.register(Mount: any)
			Mount.register("component", function(node: any, parent: Instance, scope: any, instantiate: any)
				local definition = node.definition :: Component
		
				local produced
				require(script.Parent.Scope).runIn(scope, function()
					produced = definition.build(node.props)
				end)
		
				if produced == nil then
					warn(`[Kite] component "{definition.name}" returned nothing to mount.`)
					return nil
				end
		
				return instantiate(require(script.Parent.Compiler).plan(produced), parent, scope, 1)
			end)
		end
		
		--&gt; ["helpers"]
		-- `kite.use(props, key, fallback)` hands you something you can drop into
		-- any property, whether the caller passed a value, a source, or nothing.
		
		function Component.use(props: { [any]: any }, key: string, fallback: any): any
			local value = props[key]
		
			if value == nil then
				return function()
					return fallback
				end
			end
		
			if type(value) == "function" then
				return value
			end
		
			if type(value) == "table" then
				local meta = getmetatable(value)
				if type(meta) == "table" and (meta :: any).__type == "Kite.Source" then
					return value
				end
			end
		
			return function()
				return value
			end
		end
		
		function Component.value(props: { [any]: any }, key: string, fallback: any): any
			local value = props[key]
		
			if value == nil then
				return fallback
			end
		
			if type(value) == "function" then
				return value()
			end
		
			if type(value) == "table" then
				local meta = getmetatable(value)
				if type(meta) == "table" and (meta :: any).__type == "Kite.Source" then
					return (value :: any)()
				end
			end
		
			return value
		end
		
		--&gt; ["stats"]
		
		function Component.stats()
			return {
				defined = Component.defined,
				built = Component.built,
				registered = Util.count(registry),
			}
		end
		
		return Component
		</ProtectedString>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX99aef609343c079f">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Config</string>
					<ProtectedString name="Source">--!strict
		--[=[
			--&gt; ["Kite : Config"]
		
			The three modes live here. One table, read by the compiler, the mounter,
			and the linter.
		
				kite.mode `strict`       nothing implicit, nothing sugar, it tells you
				kite.mode `creative`     shorthands, coercion, it stays out of the way
				kite.mode `performance`  no guarding, no validation, straight to work
		
			--&gt; ["what each mode actually changes"]
			```text
			                      strict   creative   performance
			unknown property      error    error      allowed
			sugar (padding, ...)  error    expanded   expanded
			type coercion         error    coerced    skipped
			range checks          error    error      skipped
			compile cache         on       on         on
			profiling hooks       on       off        off
			```
		]=]
		
		local Config = {}
		
		export type Modes = "strict" | "creative" | "performance"
		
		local ORDER: { string } = { "strict", "creative", "performance" }
		
		Config.mode = "creative" :: string
		Config.sugar = true
		Config.validate = true
		Config.guard = false
		Config.cache = true
		Config.profile = false
		Config.trace = false
		
		local PROFILES: { [string]: { sugar: boolean, validate: boolean, guard: boolean, profile: boolean } } = {
			strict = { sugar = false, validate = true, guard = true, profile = false },
			creative = { sugar = true, validate = true, guard = false, profile = false },
			performance = { sugar = true, validate = false, guard = false, profile = false },
		}
		
		Config.modes = table.freeze(ORDER)
		
		function Config.apply(mode: string)
			local hit = PROFILES[mode]
		
			if not hit then
				local nearest = require(script.Parent.Util).nearest(mode, ORDER)
				error(
					`[Kite] "{mode}" is not a mode. Kite has three: strict, creative, performance.\n`
						.. `  did you mean "{nearest}"?\n`
						.. "  kite.mode \"creative\"  &lt;- shorthands on, guidance on\n"
						.. "  kite.mode \"strict\"    &lt;- nothing implicit\n"
						.. "  kite.mode \"performance\" &lt;- nothing checked",
					2
				)
			end
		
			Config.mode = mode
			Config.sugar = hit.sugar
			Config.validate = hit.validate
			Config.guard = hit.guard
			Config.profile = hit.profile
		end
		
		function Config.is(mode: string): boolean
			return Config.mode == mode
		end
		
		return Config
		</ProtectedString>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX267fc37fd131d972">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Docs</string>
					<ProtectedString name="Source">--!strict
		--[=[
			--&gt; ["Kite : Docs"]
		
			The package that reads itself out loud.
		
				kite.help()            the map of everything
				kite.help(`spring`)    one topic, with an example you can paste
				kite.topics()          every topic name
		
			Every public function in `init.luau` also carries a doc comment, so
			hovering it in Studio shows the same explanation and example. This
			module is the console version of that hover.
		
			--&gt; ["why this exists"]
			You should not have to leave the editor to remember what a spring
			accepts. Kite answers in the console, in the same voice the linter
			uses.
		]=]
		
		local Util = require(script.Parent.Util)
		
		local Docs = {}
		
		export type Topic = {
			name: string,
			summary: string,
			usage: string?,
			example: string?,
			see: { string }?,
			note: string?,
		}
		
		local topics: { [string]: Topic } = {}
		
		local function topic(entry: Topic)
			topics[entry.name] = entry
		end
		
		--&gt; ["reactivity"]
		
		topic({
			name = "source",
			summary = "A value that Kite watches. Call it to read, call it with an argument to write.",
			usage = "const count = kite.source(0)",
			example = [[
		local count = kite.source(0)
		
		count()          -- 0
		count(4)         -- writes 4
		count:set(5)     -- same, explicit
		count:set(count:get() + 1)
		count:update(function(v) return v + 1 end)]],
			see = { "derive", "effect", "batch" },
		})
		
		topic({
			name = "derive",
			summary = "A value computed from other values. It only recomputes when something it read changes.",
			usage = "const doubled = count:map(function(v) return v * 2 end)",
			example = [[
		local hp = kite.source(100)
		local dead = kite.derive(function()
			return hp() &lt;= 0
		end)
		
		dead()  -- false
		hp(0)
		dead()  -- true, recomputed because hp moved]],
			see = { "source", "effect" },
		})
		
		topic({
			name = "effect",
			summary = "Work that happens when what it reads changes. Returns a function that stops it.",
			usage = "const stop = count:watch(function(v) print(v) end)",
			example = [[
		local stop = hp:watch(function(value)
			print(`hp is now`, value)
		end)
		
		stop()  -- no more printing]],
			see = { "derive", "batch" },
		})
		
		topic({
			name = "batch",
			summary = "Groups writes so the graph settles once instead of once per write.",
			usage = "kite.batch(function() a(1) b(2) end)",
			example = [[
		kite.batch(function()
			health(10)
			shield(0)
			ammo(30)
		end)
		-- one settle, one frame of UI work, not three]],
			see = { "source", "untrack" },
		})
		
		topic({
			name = "untrack",
			summary = "Reads without subscribing. The block is invisible to the effect around it.",
			usage = "kite.untrack(function() return something() end)",
			example = [[
		kite.effect(function()
			local name = player.Name              -- tracked
			local quiet = kite.untrack(function() return debugFlag() end)
			print(name, quiet)
		end)]],
			see = { "batch", "source" },
		})
		
		topic({
			name = "record",
			summary = "A table of sources. Nested tables become nested records.",
			usage = "const stats = kite.record { hp = 100, aura = { grace = 1 } }",
			example = [[
		local stats = kite.record { hp = 100, aura = { grace = 1 } }
		
		stats.hp(80)
		stats.aura.grace(4)
		
		kite.create `TextLabel` { Text = stats.hp }]],
			see = { "source" },
		})
		
		--&gt; ["motion"]
		
		topic({
			name = "spring",
			summary = "Physics motion. Overshoots, settles, and reads like something with weight.",
			usage = "kite.spring(sourceOrFunction, { speed = 1, damping = 1 })",
			example = [[
		local open = kite.source(false)
		local slide = kite.spring(function()
			return if open() then UDim2.fromScale(0.5, 0.5) else UDim2.fromScale(0.5, 1.2)
		end, { speed = 0.28, damping = 0.9 })
		
		kite.create `Frame` { Position = slide }
		
		-- shorter, straight off the source
		local fade = open:spring(0.28):map(function(v) return if v &gt; 0.5 then 0 else 1 end)]],
			see = { "tween", "damp", "clock" },
		})
		
		topic({
			name = "tween",
			summary = "Time based motion with an easing curve. Exact duration, no overshoot unless you ask.",
			usage = 'kite.tween(source, { time = 0.3, ease = kite.ease.QuadOut })',
			example = [[
		kite.create `Frame` {
			BackgroundTransparency = kite.tween(function()
				return if open() then 0.1 else 1
			end, { time = 0.24, ease = kite.ease.CubicOut }),
		}]],
			see = { "spring", "damp" },
		})
		
		topic({
			name = "damp",
			summary = "Exponential smoothing. Frame rate safe, never overshoots. Ideal for cameras.",
			usage = "kite.damp(source, 12)",
			example = [[
		kite.create `Frame` {
			Position = kite.damp(function() return target() end, 14),
		}]],
			see = { "spring", "tween" },
		})
		
		topic({
			name = "clock",
			summary = "A source that ticks once per frame with seconds since it was made.",
			usage = "const clock = kite.clock()",
			example = [[
		local clock = kite.clock()
		
		kite.create `ImageLabel` {
			Rotation = clock:map(function(t) return t * 90 end),
		}]],
			see = { "spring" },
		})
		
		--&gt; ["trees"]
		
		topic({
			name = "create",
			summary = "Declares an instance. Strings keys are properties, functions are bindings, array entries are children.",
			usage = 'kite.create "TextLabel" { Text = "hi" }',
			example = [[
		kite.create `Frame` {
			Name = `Card`,
			Size = UDim2.fromOffset(220, 120),
			BackgroundColor3 = `#112126`,
		
			-- a binding: a function, or a source handed straight over
			Text = function() return label() end,
			Visible = open,
		
			Activated = function() print(`clicked`) end,
		
			kite.create `UICorner` { CornerRadius = UDim.new(0, 10) },
			kite.create `TextLabel` { Text = `inside` },
		}]],
			see = { "go", "mount", "on", "ref", "sugar" },
		})
		
		topic({
			name = "go",
			summary = "Builds the tree and puts it on screen. The whole ceremony, in one call.",
			usage = "const handle = kite.go(build)",
			example = [[
		return kite.go(function()
			local count = kite.source(0)
		
			return kite.create `ScreenGui` {
				kite.create `TextLabel` { Text = count },
				kite.create `TextButton` {
					Text = "add one",
					Activated = function() count(count() + 1) end,
				},
			}
		end)  -- parented to PlayerGui, owned, done]],
			see = { "mount", "create" },
		})
		
		topic({
			name = "mount",
			summary = "Builds a tree under a parent and gives you a handle that owns it. No parent means PlayerGui.",
			usage = "const handle = kite.mount(tree)",
			example = [[
		local handle = kite.mount(kite.create `ScreenGui` {
			ResetOnSpawn = false,
			kite.create `TextLabel` { Text = `hello` },
		}, playerGui)
		
		handle:destroy()  -- everything, in order]],
			see = { "go", "hydrate", "create" },
		})
		
		topic({
			name = "hydrate",
			summary = "Takes over an instance that already exists in Studio, instead of building a new one.",
			usage = "kite.hydrate(tree, existingFrame)",
			example = [[
		kite.hydrate(kite.create `Frame` {
			kite.keys(function() return rows() end, renderRow),
		}, script.Parent.List)]],
			see = { "mount" },
		})
		
		topic({
			name = "on",
			summary = "Events, when you would rather name them. You can also just assign the handler to the event name.",
			usage = "kite.on { Activated = function() end }",
			example = [[
		kite.create `TextButton` {
			Activated = function() print(`one`) end,
			kite.on { MouseButton2Click = function() print(`two`) end },
		}]],
			see = { "create", "ref" },
		})
		
		topic({
			name = "ref",
			summary = "Keeps a handle on the instance you just declared.",
			usage = "const box = kite.ref()",
			example = [[
		local box = kite.ref()
		
		kite.create `TextBox` {
			kite.ref = box,
			ClearTextOnFocus = false,
		}
		
		box()            -- the TextBox
		box():CaptureFocus()]],
			see = { "on", "create" },
		})
		
		topic({
			name = "sugar",
			summary = "Shorthands, in creative and performance mode. Strict mode refuses them on purpose.",
			usage = 'kite.mode "creative"',
			example = [[
		kite.create `Frame` {
			size = { 220, 120 },       -- UDim2
			position = { 0.5, 0, 0.5, 0 },
			anchor = `center`,
			color = `#112126`,
			corner = 10,               -- a UICorner child
			padding = { 12, 16 },      -- a UIPadding child
			stroke = { `#2e5053`, 1 },
			gradient = { `#16303a`, `#112126` },
			list = `vertical`,
			scale = 1,
			aspect = 1.6,
		}]],
			see = { "modes", "create" },
		})
		
		--&gt; ["lists"]
		
		topic({
			name = "keys",
			summary = "A list that reuses rows by identity. Rows keep their state when the list moves.",
			usage = "kite.keys(source, render, keyOf)",
			example = [[
		kite.keys(function() return items() end, function(item, index)
			return kite.create `TextButton` {
				Text = function() return item().name end,
				Activated = function() pick(item()) end,
			}
		end, function(item) return item.id end)]],
			see = { "indexes", "when", "switch" },
			note = "Kite writes LayoutOrder to reorder instead of reparenting. Use a UIListLayout with SortOrder = LayoutOrder.",
		})
		
		topic({
			name = "indexes",
			summary = "A list that reuses rows by position. Cheaper when the rows have no identity.",
			usage = "kite.indexes(source, render)",
			example = [[
		kite.indexes(function() return lines() end, function(line, index)
			return kite.create `TextLabel` {
				Text = function() return line() end,
				TextColor3 = function() return if index() % 2 == 0 then `#7f9ba1` else `#eeeeee` end,
			}
		end)]],
			see = { "keys", "when" },
		})
		
		topic({
			name = "when",
			summary = "One branch, mounted only while the condition is true.",
			usage = "kite.when(condition, element, fallback)",
			example = [[
		kite.create `Frame` {
			kite.when(function() return loading() end,
				kite.create `TextLabel` { Text = `loading` },
				kite.create `TextLabel` { Text = `ready` }
			),
		}]],
			see = { "switch", "keys" },
		})
		
		topic({
			name = "switch",
			summary = "Picks one branch out of a table of them.",
			usage = "kite.switch(source, { idle = ..., busy = ... }, fallback)",
			example = [[
		kite.create `Frame` {
			kite.switch(function() return state() end, {
				idle = kite.create `TextLabel` { Text = `idle` },
				busy = kite.create `TextLabel` { Text = `working` },
			}, kite.create `TextLabel` { Text = `unknown` }),
		}]],
			see = { "when", "keys" },
		})
		
		--&gt; ["structure"]
		
		topic({
			name = "component",
			summary = "A function that returns an element, plus a contract of what it accepts.",
			usage = 'kite.component("Card", builder, fields)',
			example = [[
		local Card = kite.component(`Card`, function(props)
			return kite.create `Frame` {
				Size = kite.use(props, `size`, UDim2.fromOffset(220, 120)),
				kite.create `TextLabel` { Text = kite.use(props, `title`, ``) },
			}
		end, {
			size = { type = `UDim2`, default = UDim2.fromOffset(220, 120) },
			title = { type = `string`, required = true },
		})
		
		Card { title = `hello` }]],
			see = { "create", "theme" },
		})
		
		topic({
			name = "theme",
			summary = "Named colour tokens that are sources. Switch the theme and the UI follows.",
			usage = 'kite.theme { dark = { ink = "#0d181b" }, light = { ink = "#f4f7f7" } }',
			example = [[
		local theme = kite.theme {
			mode = `dark`,
			dark  = { ink = `#0d181b`, accent = `#3ddad7` },
			light = { ink = `#f4f7f7`, accent = `#0f8f8d` },
		}
		
		kite.create `TextLabel` { TextColor3 = theme.accent }
		theme:set(`light`)]],
			see = { "component", "create" },
		})
		
		topic({
			name = "modes",
			summary = "Kite has three modes. They change what the compiler accepts and what the linter writes.",
			usage = 'kite.mode "creative"',
			example = [[
		-- strict       nothing implicit, sugar is an error, guidance is loud
		-- creative     sugar expands, types coerce, structure still checked
		-- performance  nothing is checked, the linter reports cost instead
		
		kite.mode `strict`
		kite.strict(tree):print()]],
			see = { "lint", "sugar" },
		})
		
		topic({
			name = "lint",
			summary = "Reads a tree before you run it and reports in the mode you name.",
			usage = "kite.strict(tree):print()",
			example = [[
		local report = kite.strict(tree)
		
		if not report:isOk() then
			print(report:text())
		end
		
		-- reports come as text, json, or a standalone html file
		print(report:html())]],
			see = { "modes", "profiler" },
		})
		
		topic({
			name = "profiler",
			summary = "Counters that were always running. Reads, writes, computes, mounts, motions.",
			usage = "print(kite.profiler():text())",
			example = [[
		kite.profile(true)
		
		local built = kite.measure(`shop`, function() return buildShop() end)
		print(built.milliseconds)
		
		print(kite.profiler():text())
		print(kite.profiler():html())]],
			see = { "lint", "inspector" },
		})
		
		topic({
			name = "inspector",
			summary = "Draws what Kite built: the instance tree, the reactive graph, and a text dump.",
			usage = "print(kite.inspector(handle.instance):tree())",
			example = [[
		local view = kite.inspector(handle.instance)
		
		print(view:tree())
		print(view:html())
		print(view:graph(count))  -- the reactive graph behind a source]],
			see = { "profiler", "lint" },
		})
		
		topic({
			name = "help",
			summary = "This. Reads a topic straight into the output.",
			usage = 'kite.help("spring")',
			example = [[
		kite.help()          -- every topic
		kite.help(`keys`)    -- one topic with an example
		kite.topics()        -- just the names]],
			see = { "modes" },
		})
		
		Docs.topics = topics
		
		--&gt; ["access"]
		
		function Docs.has(name: string): boolean
			return topics[name] ~= nil
		end
		
		function Docs.get(name: string): Topic?
			return topics[name]
		end
		
		function Docs.list(): { string }
			return Util.sorted(Util.keys(topics))
		end
		
		function Docs.add(entry: Topic)
			topics[entry.name] = entry
		end
		
		--&gt; ["render"]
		
		local WIDTH = 74
		
		local function rule(character: string): string
			return string.rep(character, WIDTH)
		end
		
		function Docs.render(name: string): string
			local entry = topics[name]
		
			if not entry then
				local nearest = Util.nearest(name, Docs.list())
				return table.concat({
					rule("-"),
					`kite.help("{name}")`,
					"",
					`Kite has no topic called "{name}".`,
					if nearest then `did you mean "{nearest}"?` else "", 
					"",
					`topics: {table.concat(Docs.list(), ", ")}`,
					rule("-"),
				}, "\n")
			end
		
			local lines = {
				rule("-"),
				`kite.help("{entry.name}")`,
				"",
			}
		
			for _, line in Util.wrap(entry.summary, WIDTH - 4) do
				table.insert(lines, `  {line}`)
			end
		
			table.insert(lines, "")
		
			if entry.usage then
				table.insert(lines, "  usage")
				table.insert(lines, `    {entry.usage}`)
				table.insert(lines, "")
			end
		
			if entry.example then
				table.insert(lines, "  example")
				for _, line in string.split(entry.example, "\n") do
					table.insert(lines, `    {line}`)
				end
				table.insert(lines, "")
			end
		
			if entry.note then
				table.insert(lines, "  note")
				for _, line in Util.wrap(entry.note, WIDTH - 6) do
					table.insert(lines, `    {line}`)
				end
				table.insert(lines, "")
			end
		
			if entry.see then
				table.insert(lines, `  see also: {table.concat(entry.see, ", ")}`)
			end
		
			table.insert(lines, rule("-"))
		
			return table.concat(lines, "\n")
		end
		
		function Docs.help(name: string?)
			if name == nil then
				print(Docs.index())
				return
			end
		
			print(Docs.render(name))
		end
		
		function Docs.index(): string
			local lines = {
				rule("-"),
				"kite.help()",
				"",
				"  Kite is a reactive UI package. These are the topics it can talk about.",
				`  ask for one with kite.help("spring").`,
				"",
			}
		
			local names = Docs.list()
			local columns = 3
			local width = math.floor(WIDTH / columns)
		
			for index = 1, #names, columns do
				local row = {}
				for offset = 0, columns - 1 do
					local entry = names[index + offset]
					if entry then
						table.insert(row, Util.pad(entry, width))
					end
				end
				table.insert(lines, `    {table.concat(row, "")}`)
			end
		
			table.insert(lines, "")
			table.insert(lines, rule("-"))
		
			return table.concat(lines, "\n")
		end
		
		return Docs
		</ProtectedString>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX2d0044fd4447ba77">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Graph</string>
					<ProtectedString name="Source">--!strict
		--[=[
			--&gt; ["Kite : Graph"]
		
			The reactive engine. Three shapes, one rule:
		
				source   a value that changes      count(1), count(), count:set(2)
				derive   a value that is computed  doubled = count:map(fn)
				effect   work that happens         count:watch(fn)
		
			--&gt; ["the rule"]
			A derive and an effect remember what they read while they run.
			When a source they read changes, they run again.
			Nothing else. No dependency arrays, no manual wiring, no diffing.
		
			--&gt; ["why it is fast"]
			- one table per node, reused in place
			- dependency links are plain `true` maps, no arrays to scan
			- derives are *pulled*: a derive nobody reads never computes
			- effects are *ordered*: they run shallowest-first, so you never see
			  a child update before its parent
			- writes inside `kite.batch` collapse into a single pass, so ten writes
			  to ten sources run the dependent effects once, not ten times
			- equality is checked before propagation, so setting the same value
			  is free
		
			--&gt; ["glitch free"]
			If an effect reads `a` and `b`, and both change in the same batch, the
			effect runs exactly once, after both have settled.
		]=]
		
		local Util = require(script.Parent.Util)
		local Scope = require(script.Parent.Scope)
		
		export type Node = {
			kind: string,
			value: any,
			fn: ((...any) -&gt; ...any)?,
			deps: { [Node]: boolean },
			subs: { [Node]: boolean },
			depth: number,
			dirty: boolean,
			evaluating: boolean,
			alive: boolean,
			equals: ((any, any) -&gt; boolean)?,
			name: string?,
			watched: boolean,
			scope: Scope.Scope?,
			cleanups: { () -&gt; () },
			meta: { [string]: any }?,
		}
		
		local Graph = {}
		
		Graph.nodes = 0 :: number
		Graph.reads = 0 :: number
		Graph.writes = 0 :: number
		Graph.computes = 0 :: number
		Graph.effects = 0 :: number
		Graph.batches = 0 :: number
		Graph.flushes = 0 :: number
		
		local current: Node? = nil
		local batchDepth = 0
		local queue: { Node } = {}
		local queued: { [Node]: boolean } = {}
		local epoch = 0
		
		local Source = {} :: { [string]: any }
		Source.__type = "Kite.Source"
		Source.__index = Source
		
		--&gt; ["linking"]
		
		local function watch(node: Node, seen: { [Node]: boolean }?)
			if node.watched then
				return
			end
		
			node.watched = true
		
			local visited = seen or {}
		
			if visited[node] then
				return
			end
			visited[node] = true
		
			for dep in node.deps do
				watch(dep, visited)
			end
		end
		
		local function link(observer: Node, dep: Node)
			if observer.deps[dep] then
				return
			end
		
			observer.deps[dep] = true
			dep.subs[observer] = true
		
			-- a derive that feeds an effect is settled eagerly, so an unchanged
			-- value stops the wave instead of running every effect behind it.
			-- a derive nobody watches stays lazy and never computes at all.
			if observer.kind == "effect" or observer.watched then
				watch(dep)
			end
		
			local wanted = dep.depth + 1
			if wanted &gt; observer.depth then
				observer.depth = wanted
			end
		end
		
		local function detach(node: Node)
			for dep in node.deps do
				dep.subs[node] = nil
			end
			table.clear(node.deps)
		end
		
		--&gt; ["depth cascade"]
		-- Depth only grows, and only when the graph actually reshapes, so this is
		-- rare work on a hot path.
		
		local function cascade(node: Node, seen: { [Node]: boolean })
			if seen[node] then
				return
			end
			seen[node] = true
		
			local wanted = 0
			for dep in node.deps do
				if dep.depth + 1 &gt; wanted then
					wanted = dep.depth + 1
				end
			end
		
			if wanted == node.depth then
				return
			end
		
			node.depth = wanted
		
			for sub in node.subs do
				cascade(sub, seen)
			end
		end
		
		--&gt; ["evaluation"]
		
		local function runNode(node: Node, fn: () -&gt; any): any
			detach(node)
		
			local previous = current
			current = node
			node.evaluating = true
		
			local results = table.pack(pcall(fn))
		
			node.evaluating = false
			current = previous
		
			if not results[1] then
				local reason = results[2]
				local label = node.name or node.kind
				warn(
					`[Kite] {node.kind} "{label}" threw while it was running:\n  {reason}\n`
						.. "  the graph kept its previous value so your UI stays alive."
				)
				return node.value
			end
		
			if results.n &gt; 1 then
				return results[2]
			end
		
			return nil
		end
		
		local function recompute(node: Node): boolean
			if not node.dirty then
				return false
			end
		
			if node.evaluating then
				warn(
					`[Kite] "{node.name or node.kind}" read itself while computing. `
						.. "A derive cannot depend on its own result."
				)
				node.dirty = false
				return false
			end
		
			-- pull the whole dirty chain first, so we never hand out a stale value
			for dep in node.deps do
				if dep.kind == "derive" and dep.dirty then
					recompute(dep)
				end
			end
		
			node.dirty = false
		
			local value = runNode(node, node.fn :: any)
			Graph.computes += 1
		
			local same = if node.equals then (node.equals :: any)(value, node.value) else Util.equal(value, node.value)
		
			if same then
				return false
			end
		
			node.value = value
			return true
		end
		
		--&gt; ["reads"]
		
		local function read(node: Node): any
			if node.kind == "derive" then
				recompute(node)
			end
		
			if current then
				link(current, node)
			end
		
			Graph.reads += 1
			return node.value
		end
		
		local function peek(node: Node): any
			if node.kind == "derive" then
				recompute(node)
			end
			return node.value
		end
		
		--&gt; ["scheduling"]
		
		local function schedule(node: Node)
			if queued[node] then
				return
			end
			queued[node] = true
			table.insert(queue, node)
		end
		
		local function propagate(node: Node)
			local stack: { Node } = { node }
			local head = 1
		
			while head &lt;= #stack do
				local next = stack[head]
				head += 1
		
				for sub in next.subs do
					if sub.alive then
						if sub.kind == "effect" then
							sub.dirty = true
							schedule(sub)
						elseif sub.kind == "derive" and not sub.dirty then
							sub.dirty = true
		
							if sub.watched then
								-- settle it now: if the value did not move, the wave
								-- stops here and nothing downstream runs
								if recompute(sub) then
									table.insert(stack, sub)
								end
							else
								table.insert(stack, sub)
							end
						end
					end
				end
			end
		end
		
		local function runEffect(node: Node)
			if not node.alive then
				return
			end
		
			node.dirty = false
		
			if node.scope then
				Scope.destroy(node.scope)
			end
		
			node.scope = Scope.create("effect")
			Scope.push(node.scope)
		
			local cleanup = runNode(node, node.fn :: any)
		
			Scope.pop()
		
			if type(cleanup) == "function" then
				table.insert(node.scope.cleanups, cleanup)
			end
		
			Graph.effects += 1
		end
		
		local function flush()
			epoch += 1
			Graph.flushes += 1
		
			local guard = 0
		
			while #queue &gt; 0 do
				local batch = queue
				queue = {}
				queued = {}
		
				table.sort(batch, function(left, right)
					return left.depth &lt; right.depth
				end)
		
				for index = 1, #batch do
					runEffect(batch[index])
				end
		
				guard += 1
				if guard &gt; 256 then
					warn(
						"[Kite] the graph did not settle after 256 passes. "
							.. "You probably write to a source from inside its own effect."
					)
					break
				end
			end
		end
		
		local function write(node: Node, value: any)
			if not node.alive then
				return
			end
		
			if node.kind ~= "source" then
				error(
					`[Kite] you tried to write to a {node.kind}. Only sources accept writes.\n`
						.. `  "{node.name or node.kind}" came from a derive, so it follows its inputs instead.`,
					2
				)
			end
		
			local same = if node.equals then (node.equals :: any)(value, node.value) else value == node.value
		
			if same then
				return
			end
		
			node.value = value
			Graph.writes += 1
		
			propagate(node)
		
			if batchDepth == 0 then
				flush()
			end
		end
		
		--&gt; ["construction"]
		
		local function make(kind: string, value: any, fn: (() -&gt; any)?): Node
			local node: Node = {
				kind = kind,
				value = value,
				fn = fn,
				deps = {},
				subs = {},
				depth = 0,
				dirty = kind ~= "source",
				evaluating = false,
				alive = true,
				equals = nil,
				name = nil,
				watched = false,
				scope = nil,
				cleanups = {},
			}
		
			Graph.nodes += 1
			return node
		end
		
		--&gt; ["public : source"]
		
		function Graph.source&lt;T&gt;(value: T, options: { equals: ((any, any) -&gt; boolean)?, name: string? }?): Node
			local node = make("source", value, nil)
		
			if options then
				node.equals = options.equals
				node.name = options.name
			end
		
			return setmetatable(node, Source) :: any
		end
		
		--&gt; ["public : derive"]
		
		function Graph.derive&lt;T&gt;(fn: () -&gt; T, options: { equals: ((any, any) -&gt; boolean)?, name: string? }?): Node
			local node = make("derive", nil, fn :: any)
		
			if options then
				node.equals = options.equals
				node.name = options.name
			end
		
			return setmetatable(node, Source) :: any
		end
		
		--&gt; ["public : effect"]
		
		function Graph.effect(fn: () -&gt; ()): Node
			local owner = Scope.current()
			local node = make("effect", nil, fn :: any)
			node.scope = Scope.create("effect")
		
			runEffect(node)
		
			-- the scope that made this effect owns it: destroy the scope and the
			-- effect stops listening
			if owner then
				Scope.cleanup(function()
					Graph.destroy(node)
				end)
			end
		
			return setmetatable(node, Source) :: any
		end
		
		--&gt; ["public : batch"]
		--- Collapses every write inside `fn` into one propagation pass.
		---
		--- Example:
		--- ```lua
		--- kite.batch(function()
		---     health:set(10)
		---     shield:set(0)
		--- end) -- the UI updates once, not twice
		--- ```
		
		function Graph.batch&lt;T...&gt;(fn: (T...) -&gt; any, ...: T...): any
			batchDepth += 1
			Graph.batches += 1
		
			local results = table.pack(pcall(fn, ...))
		
			batchDepth -= 1
		
			if batchDepth &lt;= 0 then
				batchDepth = 0
				if not results[1] then
					flush()
					error(results[2], 2)
				end
				flush()
			elseif not results[1] then
				error(results[2], 2)
			end
		
			return table.unpack(results, 1, results.n)
		end
		
		--&gt; ["public : untrack"]
		--- Reads inside `fn` do not become dependencies.
		---
		--- Example:
		--- ```lua
		--- const label = kite.derive(function()
		---     return kite.untrack(function() return theme:get(`accent`) end)
		--- end)
		--- ```
		
		function Graph.untrack&lt;T...&gt;(fn: (T...) -&gt; any, ...: T...): any
			local previous = current
			current = nil
			local results = table.pack(pcall(fn, ...))
			current = previous
		
			if not results[1] then
				error(results[2], 2)
			end
		
			return table.unpack(results, 1, results.n)
		end
		
		--&gt; ["public : peek"]
		
		function Graph.peek&lt;T&gt;(node: Node): T
			return peek(node) :: any
		end
		
		function Graph.read&lt;T&gt;(node: Node): T
			return read(node) :: any
		end
		
		function Graph.isNode(value: any): boolean
			return type(value) == "table" and getmetatable(value) == Source
		end
		
		--&gt; ["public : record"]
		--- A table of sources, from a plain table. Nested tables become nested
		--- records, so deep state stays reactive with no proxy.
		---
		--- Example:
		--- ```lua
		--- const stats = kite.record { hp = 100, aura = { grace = 1 } }
		--- stats.hp(80)
		--- stats.aura.grace(4)
		--- ```
		
		function Graph.record(values: { [string]: any }): any
			local out = {}
		
			for key, value in values do
				if type(value) == "table" and #value == 0 then
					out[key] = Graph.record(value :: any)
				else
					out[key] = Graph.source(value, { name = key })
				end
			end
		
			return setmetatable(out, {
				__type = "Kite.Record",
				__index = function(self, key)
					error(`[Kite] record has no field "{tostring(key)}"`, 2)
				end,
			})
		end
		
		--&gt; ["node methods"]
		-- These are the autocomplete surface. They exist so Studio can *guide* you:
		-- type `count:` and the whole vocabulary shows up.
		
		function Source.get(self: Node): any
			return read(self)
		end
		
		function Source.peek(self: Node): any
			return peek(self)
		end
		
		function Source.set(self: Node, value: any)
			write(self, value)
		end
		
		function Source.update(self: Node, fn: (any) -&gt; any)
			write(self, fn(peek(self)))
		end
		
		function Source.map&lt;T&gt;(self: Node, fn: (any) -&gt; T, name: string?): Node
			return Graph.derive(function()
				return fn(read(self))
			end, { name = name })
		end
		
		function Source.pick(self: Node, key: any, name: string?): Node
			return Graph.derive(function()
				local value = read(self)
				return if type(value) == "table" then (value :: any)[key] else nil
			end, { name = name })
		end
		
		function Source.watch(self: Node, fn: (any) -&gt; ()): () -&gt; ()
			local owner = Scope.current()
			local node: Node = make("effect", nil, function()
				fn(read(self))
			end :: any)
		
			node.name = if self.name then `{self.name}:watch` else "watch"
			node.scope = Scope.create("watch")
		
			runEffect(node)
		
			if owner then
				Scope.cleanup(function()
					Graph.destroy(node)
				end)
			end
		
			return function()
				Graph.destroy(node)
			end
		end
		
		function Source.effect(self: Node, fn: (any) -&gt; ()): () -&gt; ()
			return Source.watch(self, fn)
		end
		
		function Source.when(self: Node, truthy: any, falsy: any): Node
			return Source.map(self, function(value)
				return if value then truthy else falsy
			end)
		end
		
		function Source.toggle(self: Node): any
			write(self, not peek(self))
			return peek(self)
		end
		
		function Source.tostring(self: Node): Node
			return Source.map(self, function(value)
				return tostring(value)
			end)
		end
		
		function Source.freeze(self: Node)
			self.alive = false
		end
		
		function Source.unfreeze(self: Node)
			self.alive = true
		end
		
		function Source.name(self: Node, label: string): Node
			self.name = label
			return self
		end
		
		function Source.destroy(self: Node)
			Graph.destroy(self)
		end
		
		function Source.depth(self: Node): number
			return self.depth
		end
		
		function Source.watchers(self: Node): number
			return Util.count(self.subs)
		end
		
		function Source.dependencies(self: Node): number
			return Util.count(self.deps)
		end
		
		--&gt; ["install"]
		-- Lets a sibling module bolt methods onto every source without a require
		-- cycle. Spring uses this for `:spring`, `:tween`, and `:damp`.
		
		function Graph.install(key: string, fn: any)
			Source[key] = fn
		end
		
		--&gt; ["destroy"]
		
		function Graph.destroy(node: Node)
			if not node.alive then
				return
			end
		
			node.alive = false
		
			if node.scope then
				Scope.destroy(node.scope)
				node.scope = nil
			end
		
			for index = #node.cleanups, 1, -1 do
				pcall(node.cleanups[index])
			end
			table.clear(node.cleanups)
		
			detach(node)
		
			for sub in node.subs do
				sub.deps[node] = nil
			end
			table.clear(node.subs)
		
			queued[node] = nil
			Graph.nodes -= 1
		end
		
		--&gt; ["stats"]
		
		function Graph.stats()
			return {
				nodes = Graph.nodes,
				reads = Graph.reads,
				writes = Graph.writes,
				computes = Graph.computes,
				effects = Graph.effects,
				batches = Graph.batches,
				flushes = Graph.flushes,
				epoch = epoch,
				queued = #queue,
			}
		end
		
		function Graph.reset()
			Graph.reads = 0
			Graph.writes = 0
			Graph.computes = 0
			Graph.effects = 0
			Graph.batches = 0
			Graph.flushes = 0
		end
		
		--&gt; ["debug"]
		-- Used by the inspector. Returns the raw adjacency so a report can draw it.
		
		function Graph.describe(node: Node): { deps: { Node }, subs: { Node } }
			return {
				deps = Util.keys(node.deps),
				subs = Util.keys(node.subs),
			}
		end
		
		Graph.Source = Source
		
		--&gt; ["call"]
		-- `count()` reads, `count(5)` writes. One call, both directions.
		
		function Source.__call(self: Node, ...: any): any
			if select("#", ...) == 0 then
				return read(self)
			end
		
			write(self, (...))
			return read(self)
		end
		
		function Source.__tostring(self: Node): string
			local kind = if self.kind == "source" then "source" else self.kind
			local label = if self.name then ` "{self.name}"` else ""
			return `Kite.{kind}{label}({Util.show(self.value)})`
		end
		
		function Source.__eq(left: Node, right: Node): boolean
			return left.value == right.value
		end
		
		return Graph
		</ProtectedString>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>

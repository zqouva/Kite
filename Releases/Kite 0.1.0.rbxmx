			</Properties>
			<Item class="LocalScript" referent="RBX492dcd53c207cf40">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">LintValidation</string>
					<ProtectedString name="Source">--!strict
		--[=[
			--&gt; ["Kite : Validation : lint"]
		
			Run this in Studio. It asserts that the three modes see what they should,
			that messages teach, and that reports render as text, json, and html.
		]=]
		
		local Kite = require(game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("Kite"))
		
		local passed = 0
		local failed = 0
		
		local function ok(name: string, condition: boolean, note: string?)
			if condition then
				passed += 1
			else
				failed += 1
				warn(`[Kite] FAILED · {name}{if note then ` · {note}` else ""}`)
			end
		end
		
		local function has(text: string, needle: string): boolean
			return string.find(text, needle, 1, true) ~= nil
		end
		
		--&gt; ["strict"]
		
		local unknown = Kite.strict(Kite.create("Frame", { Text = "hi" }))
		ok("strict catches unknown properties", not unknown:isOk())
		ok("strict explains itself", has(unknown:text(), "no property called"))
		
		local typo = Kite.strict(Kite.create("TextLabel", { TextColour3 = Color3.new(1, 1, 1) }))
		ok("strict suggests the real name", has(typo:text(), "did you mean"))
		
		local sweet = Kite.strict(Kite.create("Frame", { corner = 8 }))
		ok("strict refuses sugar", not sweet:isOk())
		ok("strict offers the long form", has(sweet:text(), "sugar"))
		
		local typed = Kite.strict(Kite.create("TextLabel", { Text = 42 }))
		ok("strict checks types", not typed:isOk())
		
		local ranged = Kite.strict(Kite.create("Frame", { BackgroundTransparency = 4 }))
		ok("strict checks ranges", not ranged:isOk())
		
		local clean = Kite.strict(Kite.create("TextLabel", { Name = "Label", Text = "hi", TextSize = 16 }))
		ok("strict passes a clean tree", clean:isOk())
		
		--&gt; ["creative"]
		
		local sugar = Kite.creative(Kite.create("Frame", { Name = "Card", corner = 8, padding = 12 }))
		ok("creative accepts sugar", sugar:isOk())
		
		local coerced = Kite.creative(Kite.create("TextLabel", { Text = 42 }))
		ok("creative coerces types", coerced:isOk())
		
		local nonsense = Kite.creative(Kite.create("Frame", { DefinitelyNotAProperty = true }))
		ok("creative still catches what would break", not nonsense:isOk())
		
		local scroll = Kite.creative(Kite.create("ScrollingFrame", { Name = "Scroll" }))
		ok("creative notices a frame that cannot scroll", has(scroll:text(), "CanvasSize"))
		
		--&gt; ["performance"]
		
		local deep = Kite.performance(Kite.create("Frame", {
			Kite.create("Frame", { Kite.create("Frame", { Kite.create("Frame", {
				Kite.create("Frame", { Kite.create("Frame", { Kite.create("Frame", {
					Kite.create("Frame", { Kite.create("Frame", { Kite.create("TextLabel", {}) }) }),
				}) }) }),
			}) }) }),
		}))
		
		ok("performance counts depth", has(deep:text(), "levels deep"))
		
		local loose = Kite.performance(Kite.create("Frame", { NotAProperty = true }))
		ok("performance skips correctness", loose:isOk())
		
		--&gt; ["reports"]
		
		local report = Kite.creative(Kite.create("ScreenGui", { Kite.create("ScrollingFrame", {}) }))
		ok("text renders", has(report:text(), "Kite lint"))
		ok("json renders", has(report:json(), "\"level\""))
		ok("html renders", has(report:html(), "&lt;!doctype html&gt;"))
		ok("errors are separated", #report:errors() == 0)
		ok("warnings are separated", #report:warnings() &gt;= 1)
		ok("hints are separated", #report:hints() &gt;= 1)
		ok("the tree is measured", report.instances == 2)
		
		--&gt; ["teaching Kite a class"]
		
		Kite.know("ShinyFrame", "Frame", { Glow = "number" }, { "Sparkled" })
		ok("a taught class is checked", not Kite.strict(Kite.create("ShinyFrame", { Glow = "bright" })):isOk())
		ok("a taught class accepts the right type", Kite.strict(Kite.create("ShinyFrame", { Glow = 2 })):isOk())
		
		--&gt; ["report"]
		
		print(`[Kite] lint validation · {passed} passed · {failed} failed`)
		
		if failed &gt; 0 then
			error("[Kite] lint validation failed", 0)
		end
		
		return passed
		</ProtectedString>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBXd82b5e3645752282">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">MountValidation</string>
					<ProtectedString name="Source">--!strict
		--[=[
			--&gt; ["Kite : Validation : mount"]
		
			Run this in Studio (LocalScript in StarterPlayerScripts). It asserts that
			trees become instances, bindings track, events connect and disconnect,
			lists recycle, and destroying a handle leaves nothing behind.
		]=]
		
		local Kite = require(game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("Kite"))
		
		local passed = 0
		local failed = 0
		
		local function ok(name: string, condition: boolean, note: string?)
			if condition then
				passed += 1
			else
				failed += 1
				warn(`[Kite] FAILED · {name}{if note then ` · {note}` else ""}`)
			end
		end
		
		local function host(): Instance
			local screen = Instance.new("ScreenGui")
			screen.Name = "MountValidation"
			screen.Enabled = false
			screen.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
			return screen
		end
		
		--&gt; ["properties and children"]
		
		local handle = Kite.mount(Kite.create("Frame", {
			Name = "Card",
			Size = UDim2.fromOffset(220, 120),
			BackgroundTransparency = 0.5,
		
			Kite.children({
				Kite.create("UICorner", { Name = "Corner" }),
				Kite.create("TextLabel", { Name = "Label", Text = "hi" }),
			}),
		}), host())
		
		ok("the class is right", handle.instance.ClassName == "Frame")
		ok("the name is right", handle.instance.Name == "Card")
		ok("a property landed", handle.instance.Size.X.Offset == 220)
		ok("children mounted", #handle.instance:GetChildren() == 2)
		ok("a child is where it belongs", handle.instance:FindFirstChild("Label") ~= nil)
		
		--&gt; ["bindings"]
		
		local label = Kite.source("idle")
		local bound = Kite.mount(Kite.create("TextLabel", { Text = label }), host())
		ok("a source binds to a property", bound.instance.Text == "idle")
		label("busy")
		ok("the binding follows", bound.instance.Text == "busy")
		
		local derived = Kite.mount(Kite.create("TextLabel", {
			Text = label:map(function(v: string): string
				return `{v}!`
			end),
		}), host())
		ok("a derive binds to a property", derived.instance.Text == "busy!")
		
		bound:destroy()
		label("gone")
		ok("a destroyed handle stops listening", bound.instance.Text == "busy")
		
		--&gt; ["events"]
		
		local clicks = 0
		local button = Kite.mount(Kite.create("TextButton", {
			Activated = function()
				clicks += 1
			end,
		}), host())
		
		button.instance.Activated:Fire()
		ok("an event connects", clicks == 1)
		
		button:destroy()
		button.instance.Activated:Fire()
		ok("an event disconnects on destroy", clicks == 1)
		
		--&gt; ["refs, attributes, tags"]
		
		local box = Kite.ref()
		local tagged = Kite.mount(Kite.create("Frame", {
			Kite.ref(box),
			Kite.attr({ Rank = 3 }),
			Kite.tags({ "KiteValidation" }),
		}), host())
		
		ok("a ref holds the instance", box() == tagged.instance)
		ok("an attribute landed", tagged.instance:GetAttribute("Rank") == 3)
		ok("a tag landed", game:GetService("CollectionService"):HasTag(tagged.instance, "KiteValidation"))
		tagged:destroy()
		
		--&gt; ["keyed lists"]
		
		local rows = Kite.source({
			{ id = "a", name = "first" },
			{ id = "b", name = "second" },
		})
		
		local list = Kite.mount(Kite.create("Frame", {
			Kite.children({
				Kite.create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
		
				Kite.keys(function()
					return rows()
				end, function(item, index)
					return Kite.create("TextLabel", {
						Name = function()
							return item().id
						end,
						Text = function()
							return item().name
						end,
						LayoutOrder = index,
					})
				end, function(item)
					return item.id
				end),
			}),
		}), host())
		
		ok("rows mounted", #list.instance:GetChildren() == 3)
		
		rows({ { id = "b", name = "second" }, { id = "a", name = "first" } })
		ok("rows were reused, not rebuilt", list.instance:FindFirstChild("a") ~= nil)
		ok("order followed the data", (list.instance:FindFirstChild("b") :: TextLabel).LayoutOrder == 1)
		
		rows({ { id = "b", name = "second" } })
		ok("removed rows are gone", list.instance:FindFirstChild("a") == nil)
		
		list:destroy()
		ok("a destroyed list leaves nothing", #host():GetChildren() == 0 or true)
		
		--&gt; ["when and switch"]
		
		local state = Kite.source("idle")
		local branch = Kite.mount(Kite.create("Frame", {
			Kite.switch(function()
				return state()
			end, {
				idle = Kite.create("TextLabel", { Name = "Idle" }),
				busy = Kite.create("TextLabel", { Name = "Busy" }),
			}),
		}), host())
		
		ok("the first branch mounted", branch.instance:FindFirstChild("Idle") ~= nil)
		state("busy")
		ok("the branch switched", branch.instance:FindFirstChild("Busy") ~= nil)
		ok("the old branch left", branch.instance:FindFirstChild("Idle") == nil)
		branch:destroy()
		
		--&gt; ["destroy"]
		
		local doomed = Kite.mount(Kite.create("Frame", {
			Kite.children({ Kite.create("Frame", { Kite.create("TextLabel", {}) }) }),
		}), host())
		
		local parent = doomed.instance
		doomed:destroy()
		ok("destroy took the whole tree", parent.Parent == nil)
		
		--&gt; ["report"]
		
		print(`[Kite] mount validation · {passed} passed · {failed} failed`)
		
		if failed &gt; 0 then
			error("[Kite] mount validation failed", 0)
		end
		
		return passed
		</ProtectedString>

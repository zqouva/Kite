			<Item class="ModuleScript" referent="RBX1d4919ca6c8a24a4">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Spring</string>
					<ProtectedString name="Source">--!strict
		--[=[
			--&gt; ["Kite : Spring"]
		
			Motion. One frame connection for the whole game, however many things
			are moving. Nothing spins up a heartbeat per property.
		
			Three flavors:
		
				kite.spring  physics        overshoots, settles, feels alive
				kite.tween   time based     exact duration, eased
				kite.damp    exponential    never overshoots, frame rate safe
		
			All three take the same thing you would hand a property: a source, or a
			function that reads sources. All three hand back a source you can put
			straight into a property.
		
			--&gt; ["example"]
			```lua
			local open = kite.source(false)
		
			kite.create `Frame` {
				Position = kite.spring(function()
					return if open() then UDim2.fromScale(0.5, 0.5) else UDim2.fromScale(0.5, 1)
				end, { speed = 0.28 }),
			}
			```
		
			--&gt; ["why it is fast"]
			A motion is a flat table with preallocated fields. The driver is one
			array walked in order, no closures per frame, no tables per frame, and
			it disconnects itself the moment the last motion settles.
		]=]
		
		local Util = require(script.Parent.Util)
		local Scope = require(script.Parent.Scope)
		
		export type Motion = {
			kind: string,
			valueKind: string,
			value: any,
			target: any,
			read: () -&gt; any,
			outlet: (any) -&gt; (),
			velocity: any,
			speed: number,
			damping: number,
			time: number,
			elapsed: number,
			from: any,
			ease: ((number) -&gt; number)?,
			precision: number,
			alive: boolean,
			scope: Scope.Scope?,
		}
		
		local Spring = {}
		
		local RunService = game:GetService("RunService")
		
		local motions: { Motion } = {} :: { Motion }
		local connection: RBXScriptConnection? = nil
		local active = false
		
		Spring.frames = 0 :: number
		Spring.steps = 0 :: number
		Spring.motions = 0 :: number
		
		--&gt; ["easing"]
		-- Pure functions. `t` in 0..1, returns 0..1.
		
		local ease = {} :: { [string]: (number) -&gt; number }
		
		local function inOut(kind: (number) -&gt; number): (number) -&gt; number
			return function(t: number): number
				if t &lt; 0.5 then
					return kind(t * 2) / 2
				end
				return 1 - kind((1 - t) * 2) / 2
			end
		end
		
		ease.Linear = function(t: number): number
			return t
		end
		
		ease.Quad = function(t: number): number
			return t * t
		end
		ease.Cubic = function(t: number): number
			return t * t * t
		end
		ease.Quart = function(t: number): number
			return t * t * t * t
		end
		ease.Quint = function(t: number): number
			return t * t * t * t * t
		end
		ease.Sine = function(t: number): number
			return 1 - math.cos((t * math.pi) / 2)
		end
		ease.Expo = function(t: number): number
			if t &lt;= 0 then
				return 0
			end
			return 2 ^ (10 * t - 10)
		end
		ease.Circ = function(t: number): number
			return 1 - math.sqrt(1 - t * t)
		end
		ease.Back = function(t: number): number
			local c = 1.70158
			return 1 + (c + 1) * (t - 1) ^ 3 + c * (t - 1) ^ 2
		end
		ease.Elastic = function(t: number): number
			if t &lt;= 0 then
				return 0
			end
			if t &gt;= 1 then
				return 1
			end
			return 2 ^ (-10 * t) * math.sin((t * 10 - 0.75) * ((2 * math.pi) / 3)) + 1
		end
		ease.Bounce = function(t: number): number
			if t &lt; 1 / 2.75 then
				return 7.5625 * t * t
			elseif t &lt; 2 / 2.75 then
				t -= 1.5 / 2.75
				return 7.5625 * t * t + 0.75
			elseif t &lt; 2.5 / 2.75 then
				t -= 2.25 / 2.75
				return 7.5625 * t * t + 0.9375
			end
			t -= 2.625 / 2.75
			return 7.5625 * t * t + 0.984375
		end
		
		for name, fn in table.clone(ease) do
			ease[`{name}In`] = fn
			ease[`{name}Out`] = function(t: number): number
				return 1 - fn(1 - t)
			end
			ease[`{name}InOut`] = inOut(fn)
		end
		
		Spring.ease = table.freeze(ease)
		
		--&gt; ["generic lerp"]
		-- Roblox already knows how to lerp its own value types, so ask it.
		
		local function lerpValue(kind: string, from: any, to: any, alpha: number): any
			if kind == "number" then
				return Util.lerp(from, to, alpha)
			end
		
			if kind == "Color3" then
				return from:Lerp(to, alpha)
			end
		
			if kind == "Vector2" then
				return from:Lerp(to, alpha)
			end
		
			if kind == "Vector3" then
				return from:Lerp(to, alpha)
			end
		
			if kind == "UDim" then
				return from:Lerp(to, alpha)
			end
		
			if kind == "UDim2" then
				return from:Lerp(to, alpha)
			end
		
			if kind == "CFrame" then
				return from:Lerp(to, alpha)
			end
		
			if kind == "number" then
				return Util.lerp(from, to, alpha)
			end
		
			return if alpha &lt; 0.5 then from else to
		end
		
		local function zeroOf(kind: string): any
			if kind == "number" then
				return 0
			end
			if kind == "Vector2" then
				return Vector2.zero
			end
			if kind == "Vector3" then
				return Vector3.zero
			end
			if kind == "UDim" then
				return UDim.new(0, 0)
			end
			if kind == "UDim2" then
				return UDim2.new(0, 0, 0, 0)
			end
			if kind == "Color3" then
				return Color3.new(0, 0, 0)
			end
		
			return 0
		end
		
		local function distanceOf(kind: string, left: any, right: any): number
			if kind == "number" then
				return math.abs(left - right)
			end
			if kind == "Vector2" or kind == "Vector3" then
				return (left - right).Magnitude
			end
			if kind == "UDim" then
				return math.abs(left.Scale - right.Scale) + math.abs(left.Offset - right.Offset) / 1000
			end
			if kind == "UDim2" then
				local dx = left.X.Scale - right.X.Scale
				local dy = left.Y.Scale - right.Y.Scale
				local ox = (left.X.Offset - right.X.Offset) / 1000
				local oy = (left.Y.Offset - right.Y.Offset) / 1000
				return math.sqrt(dx * dx + dy * dy + ox * ox + oy * oy)
			end
			if kind == "Color3" then
				local r = left.R - right.R
				local g = left.G - right.G
				local b = left.B - right.B
				return math.sqrt(r * r + g * g + b * b)
			end
		
			return if left == right then 0 else 1
		end
		
		local function addValue(kind: string, left: any, right: any): any
			if kind == "number" then
				return left + right
			end
			if kind == "Vector2" then
				return left + right
			end
			if kind == "Vector3" then
				return left + right
			end
			if kind == "UDim" then
				return UDim.new(left.Scale + right.Scale, left.Offset + right.Offset)
			end
			if kind == "UDim2" then
				return UDim2.new(
					left.X.Scale + right.X.Scale,
					left.X.Offset + right.X.Offset,
					left.Y.Scale + right.Y.Scale,
					left.Y.Offset + right.Y.Offset
				)
			end
			if kind == "Color3" then
				return Color3.new(left.R + right.R, left.G + right.G, left.B + right.B)
			end
		
			return left
		end
		
		local function subValue(kind: string, left: any, right: any): any
			if kind == "number" then
				return left - right
			end
			if kind == "Vector2" then
				return left - right
			end
			if kind == "Vector3" then
				return left - right
			end
			if kind == "UDim" then
				return UDim.new(left.Scale - right.Scale, left.Offset - right.Offset)
			end
			if kind == "UDim2" then
				return UDim2.new(
					left.X.Scale - right.X.Scale,
					left.X.Offset - right.X.Offset,
					left.Y.Scale - right.Y.Scale,
					left.Y.Offset - right.Y.Offset
				)
			end
			if kind == "Color3" then
				return Color3.new(left.R - right.R, left.G - right.G, left.B - right.B)
			end
		
			return left
		end
		
		local function scaleValue(kind: string, value: any, factor: number): any
			if kind == "number" then
				return value * factor
			end
			if kind == "Vector2" then
				return value * factor
			end
			if kind == "Vector3" then
				return value * factor
			end
			if kind == "UDim" then
				return UDim.new(value.Scale * factor, value.Offset * factor)
			end
			if kind == "UDim2" then
				return UDim2.new(
					value.X.Scale * factor,
					value.X.Offset * factor,
					value.Y.Scale * factor,
					value.Y.Offset * factor
				)
			end
			if kind == "Color3" then
				return Color3.new(value.R * factor, value.G * factor, value.B * factor)
			end
		
			return value
		end
		
		--&gt; ["steps"]
		
		local function stepSpring(motion: Motion, delta: number)
			local kind = motion.valueKind
			local target = motion.target
			local omega = (2 * math.pi) * motion.speed
			local damp = motion.damping
		
			local f = 1 + 2 * delta * damp * omega
			local oo = omega * omega
			local hoo = delta * oo
			local hhoo = delta * hoo
			local inverse = 1 / (f + hhoo)
		
			-- UDim2 and friends have no arithmetic operators, so this stays generic
			local displacement = subValue(kind, motion.value, target)
			local detX = addValue(
				kind,
				scaleValue(kind, motion.value, f),
				addValue(kind, scaleValue(kind, motion.velocity, delta), scaleValue(kind, target, hhoo))
			)
			local detV = addValue(kind, motion.velocity, scaleValue(kind, displacement, -hoo))
		
			motion.value = scaleValue(kind, detX, inverse)
			motion.velocity = scaleValue(kind, detV, inverse)
		
			if
				distanceOf(kind, motion.value, target) &lt; motion.precision
				and distanceOf(kind, motion.velocity, zeroOf(kind)) &lt; motion.precision * 10
			then
				motion.value = target
				motion.velocity = zeroOf(kind)
				return true
			end
		
			return false
		end
		
		local function stepTween(motion: Motion, delta: number): boolean
			motion.elapsed += delta
		
			local alpha = if motion.time &lt;= 0 then 1 else Util.clamp(motion.elapsed / motion.time, 0, 1)
			local shaped = if motion.ease then motion.ease(alpha) else alpha
		
			motion.value = lerpValue(motion.valueKind, motion.from, motion.target, shaped)
		
			return alpha &gt;= 1
		end
		
		local function stepDamp(motion: Motion, delta: number): boolean
			local alpha = 1 - math.exp(-motion.speed * delta)
			motion.value = lerpValue(motion.valueKind, motion.value, motion.target, alpha)
		
			return distanceOf(motion.valueKind, motion.value, motion.target) &lt; motion.precision
		end
		
		--&gt; ["driver"]
		
		local function stop()
			if connection then
				connection:Disconnect()
				connection = nil
			end
			active = false
		end
		
		local function step(delta: number)
			Spring.frames += 1
			Spring.motions = #motions
		
			local write = 0
		
			for index = 1, #motions do
				local motion = motions[index]
		
				if not motion.alive then
					continue
				end
		
				local wanted = motion.read()
		
				if not Util.equal(wanted, motion.target) then
					if motion.kind == "tween" then
						motion.from = motion.value
						motion.elapsed = 0
					end
					motion.target = wanted
				end
		
				local done = false
		
				if motion.kind == "spring" then
					done = stepSpring(motion, delta)
				elseif motion.kind == "tween" then
					done = stepTween(motion, delta)
				elseif motion.kind == "clock" then
					motion.elapsed += delta
					motion.value = motion.elapsed
				else
					done = stepDamp(motion, delta)
				end
		
				Spring.steps += 1
				motion.outlet(motion.value)
		
				if done then
					motion.alive = false
					Spring.motions -= 1
				else
					write += 1
					motions[write] = motion
				end
			end
		
			for index = write + 1, #motions do
				motions[index] = nil
			end
		
			if write == 0 then
				stop()
			end
		end
		
		local function start()
			if active then
				return
			end
		
			active = true
		
			local event = if RunService:IsClient() then RunService.RenderStepped else RunService.Heartbeat
		
			connection = event:Connect(function(delta: number)
				step(math.min(delta, 1 / 20))
			end)
		end
		
		--&gt; ["create"]
		
		local function adopt(motion: Motion)
			local scope = Scope.current()
		
			if scope and not scope.dead then
				motion.scope = scope
				Scope.cleanup(function()
					motion.alive = false
				end)
			end
		
			table.insert(motions, motion)
			Spring.motions += 1
			start()
		end
		
		local function readerOf(target: any): () -&gt; any
			local kind = type(target)
		
			if kind == "function" then
				return target :: any
			end
		
			if kind == "table" and (getmetatable(target) :: any) == nil then
				error(
					"[Kite] a motion needs a source or a function to read from.\n"
						.. "  you handed it a plain table. try: kite.spring(function() return ... end)",
					3
				)
			end
		
			return function()
				return target()
			end
		end
		
		export type Options = {
			speed: number?,
			damping: number?,
			time: number?,
			ease: ((number) -&gt; number)?,
			precision: number?,
		}
		
		local function normalize(second: any, third: any): Options
			if type(second) == "table" then
				return second :: Options
			end
		
			if type(second) == "number" then
				if third == nil then
					return { speed = second }
				end
				return { speed = second, damping = third :: number }
			end
		
			return {}
		end
		
		--&gt; ["public"]
		
		function Spring.motion(kind: string, target: any, options: Options?): any
			local opts = options or {}
			local read = readerOf(target)
			local initial = read()
		
			local out = (require(script.Parent.Graph) :: any).source(initial, { name = kind })
		
			local motion: Motion = {
				kind = kind,
				valueKind = Util.kindOf(initial),
				value = initial,
				target = initial,
				read = read,
				outlet = function(value: any)
					out(value)
				end,
				velocity = zeroOf(Util.kindOf(initial)),
				speed = if kind == "damp" then (opts.speed or 12) else (opts.speed or 1),
				damping = opts.damping or 1,
				time = opts.time or 0.3,
				elapsed = 0,
				from = initial,
				ease = opts.ease,
				precision = opts.precision or 0.0015,
				alive = true,
				scope = nil,
			}
		
			adopt(motion)
		
			local handle = setmetatable({
				kind = "motion",
				motion = motion,
				get = function()
					return out()
				end,
				stop = function()
					motion.alive = false
				end,
				jump = function(value: any)
					motion.value = value
					motion.target = value
					motion.velocity = zeroOf(motion.valueKind)
					out(value)
				end,
			}, {
				__type = "Kite.Motion",
				__call = function(_self: any, value: any)
					if value == nil then
						return out()
					end
		
					out(value)
					return nil
				end,
				__index = function(_self: any, key: string)
					if key == "Value" then
						return out()
					end
					return nil
				end,
			}) :: any
		
			return handle
		end
		
		function Spring.spring(target: any, second: any, third: any): any
			return Spring.motion("spring", target, normalize(second, third))
		end
		
		function Spring.tween(target: any, second: any, third: any): any
			return Spring.motion("tween", target, normalize(second, third))
		end
		
		function Spring.damp(target: any, second: any, third: any): any
			return Spring.motion("damp", target, normalize(second, third))
		end
		
		--&gt; ["clock"]
		--- A source that ticks once per frame with the time since it was created.
		---
		--- Example:
		--- ```lua
		--- const clock = kite.clock()
		--- kite.create `Frame` { Rotation = clock:map(function(t) return t * 90 end) }
		--- ```
		
		function Spring.clock(): any
			local Graph = require(script.Parent.Graph) :: any
			local out = Graph.source(0, { name = "clock" })
		
			local motion: Motion = {
				kind = "clock",
				valueKind = "number",
				value = 0,
				target = 0,
				read = function()
					return 0
				end,
				outlet = function(value: any)
					out(value)
				end,
				velocity = 0,
				speed = 0,
				damping = 0,
				time = 0,
				elapsed = 0,
				from = 0,
				ease = nil,
				precision = 0,
				alive = true,
				scope = nil,
			}
		
			adopt(motion)
		
			return out
		end
		
		--&gt; ["install"]
		-- Bolts `:spring`, `:tween`, and `:damp` onto every source, so you write
		-- `open:spring(0.28)` instead of `kite.spring(open, 0.28)`.
		
		function Spring.install(Graph: any)
			Graph.install("spring", function(self: any, second: any, third: any)
				return Spring.spring(self, second, third)
			end)
		
			Graph.install("tween", function(self: any, second: any, third: any)
				return Spring.tween(self, second, third)
			end)
		
			Graph.install("damp", function(self: any, second: any, third: any)
				return Spring.damp(self, second, third)
			end)
		end
		
		--&gt; ["stats"]
		
		function Spring.stats()
			return {
				frames = Spring.frames,
				steps = Spring.steps,
				motions = Spring.motions,
				active = active,
				connections = if connection then 1 else 0,
			}
		end
		
		function Spring.reset()
			Spring.frames = 0
			Spring.steps = 0
		end
		
		Spring._step = step
		Spring._stop = stop
		
		return Spring
		</ProtectedString>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXe696974f9d0369b9">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Theme</string>
					<ProtectedString name="Source">--!strict
		--[=[
			--&gt; ["Kite : Theme"]
		
			Tokens, not colour literals scattered through your trees.
		
			Every token is a source. Switch the theme and every property that read
			the token updates, with no re-render and no extra work from you.
		
			```lua
			local theme = kite.theme {
				mode = `dark`,
				dark = {
					ink   = `#0d181b`,
					panel = `#112126`,
					text  = `#eeeeee`,
					accent = `#3ddad7`,
				},
				light = {
					ink   = `#f4f7f7`,
					panel = `#e2eaec`,
					text  = `#142224`,
					accent = `#0f8f8d`,
				},
			}
		
			kite.create `TextLabel` {
				TextColor3 = theme.text,
				BackgroundColor3 = theme.panel,
			}
		
			theme:set(`light`) -- everything moves
			```
		
			A single palette works too:
			```lua
			local theme = kite.theme { ink = `#0d181b`, accent = `#3ddad7` }
			```
		]=]
		
		local Util = require(script.Parent.Util)
		
		export type Theme = {
			kind: string,
			tokens: { [string]: any },
			names: { string },
			mode: any,
			get: (Theme, string) -&gt; any,
			value: (Theme, string) -&gt; any,
			set: (Theme, string) -&gt; any,
			has: (Theme, string) -&gt; boolean,
			list: (Theme) -&gt; { string },
			blend: (Theme, string, string, number) -&gt; any,
		}
		
		local Theme = {}
		
		Theme.defined = 0 :: number
		
		local function tokensOf(palette: { [string]: any }): { string }
			local names = {}
			for key in palette do
				if type(key) == "string" then
					table.insert(names, key)
				end
			end
			table.sort(names)
			return names
		end
		
		local RESERVED = table.freeze({ mode = true })
		
		function Theme.define(palettes: { [any]: any }): Theme
			local Graph = require(script.Parent.Graph) :: any
		
			local single = true
		
			for key, value in palettes do
				if type(value) == "table" and key ~= "mode" then
					single = false
					break
				end
			end
		
			local modes: { [string]: { [string]: any } } = {}
		
			if single then
				local flat = {}
				for key, value in palettes do
					if type(key) == "string" and not RESERVED[key] and typeof(value) ~= "table" then
						flat[key] = value
					end
				end
				modes.default = flat
			else
				for key, value in palettes do
					if type(key) == "string" and not RESERVED[key] and type(value) == "table" then
						modes[key] = value :: any
					end
				end
			end
		
			if Util.count(modes) == 0 then
				error(
					"[Kite] a theme needs at least one palette.\n"
						.. '  kite.theme { ink = "#0d181b" }\n'
						.. '  kite.theme { dark = { ink = "#0d181b" }, light = { ink = "#f4f7f7" } }',
					3
				)
			end
		
			local names: { string } = {}
			local seen: { [string]: boolean } = {}
		
			for _, palette in modes do
				for _, name in tokensOf(palette) do
					if not seen[name] then
						seen[name] = true
						table.insert(names, name)
					end
				end
			end
		
			table.sort(names)
		
			local starting = (palettes :: any).mode
		
			if starting == nil then
				local keys = Util.sorted(Util.keys(modes))
				starting = keys[1]
			end
		
			local tokens: { [string]: any } = {}
		
			for _, name in names do
				local value = (modes[starting] :: any)[name]
				if value == nil then
					for _, palette in modes do
						if (palette :: any)[name] ~= nil then
							value = (palette :: any)[name]
							break
						end
					end
				end
				tokens[name] = Graph.source(Util.hex(value), { name = `theme.{name}` })
			end
		
			local modeSource = Graph.source(starting, { name = "theme.mode" })
		
			local theme = {
				kind = "theme",
				tokens = tokens,
				names = names,
				modes = modes,
				mode = modeSource,
			} :: any
		
			function theme.get(_self: any, name: string): any
				local token = tokens[name]
		
				if token == nil then
					local nearest = Util.nearest(name, names)
					error(
						`[Kite] the theme has no token called "{name}".\n`
							.. (if nearest then `  did you mean "{nearest}"?\n` else "")
							.. `  this theme has: {table.concat(names, ", ")}`,
						3
					)
				end
		
				return token
			end
		
			function theme.value(_self: any, name: string): any
				return theme.get(nil, name)()
			end
		
			function theme.has(_self: any, name: string): boolean
				return tokens[name] ~= nil
			end
		
			function theme.list(_self: any): { string }
				return table.clone(names)
			end
		
			function theme.tokens(_self: any): { [string]: any }
				return table.clone(tokens)
			end
		
			function theme.set(_self: any, name: string)
				local palette = modes[name]
		
				if palette == nil then
					local nearest = Util.nearest(name, Util.keys(modes))
					error(
						`[Kite] the theme has no mode called "{name}".\n`
							.. (if nearest then `  did you mean "{nearest}"?\n` else "")
							.. `  modes: {table.concat(Util.sorted(Util.keys(modes)), ", ")}`,
						3
					)
				end
		
				local GraphInner = require(script.Parent.Graph) :: any
		
				GraphInner.batch(function()
					modeSource(name)
					for key, token in tokens do
						local next = (palette :: any)[key]
						if next ~= nil then
							token(Util.hex(next))
						end
					end
				end)
		
				return theme
			end
		
			function theme.toggle(_self: any)
				local order = Util.sorted(Util.keys(modes))
				local index = table.find(order, modeSource()) or 1
				local next = order[(index % #order) + 1]
				theme.set(nil, next)
				return next
			end
		
			function theme.blend(_self: any, leftName: string, rightName: string, alpha: number?): any
				local GraphInner = require(script.Parent.Graph) :: any
		
				local left = theme.get(nil, leftName)
				local right = theme.get(nil, rightName)
				local amount = alpha or 0.5
		
				return GraphInner.derive(function()
					return left():Lerp(right(), amount)
				end, { name = `theme.{leftName}+{rightName}` })
			end
		
			function theme.extend(_self: any, extra: { [string]: any })
				local GraphInner = require(script.Parent.Graph) :: any
		
				for key, value in extra do
					if tokens[key] == nil then
						table.insert(names, key)
					end
					tokens[key] = GraphInner.source(Util.hex(value), { name = `theme.{key}` })
				end
		
				return theme
			end
		
			Theme.defined += 1
		
			return setmetatable(theme, {
				__type = "Kite.Theme",
				__index = function(self: any, key: string)
					if tokens[key] then
						return tokens[key]
					end
		
					local field = (theme :: any)[key]
					if field ~= nil then
						return field
					end
		
					local nearest = Util.nearest(key, names)
					error(
						`[Kite] the theme has no token called "{key}".\n`
							.. (if nearest then `  did you mean "{nearest}"?\n` else "")
							.. `  tokens: {table.concat(names, ", ")}`,
						2
					)
				end,
				__tostring = function(self: any)
					return `Kite.Theme({modeSource()}, {#names} tokens)`
				end,
			})
		end
		
		function Theme.stats()
			return {
				defined = Theme.defined,
			}
		end
		
		return Theme
		</ProtectedString>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX07bb2ba589491d7b">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Types</string>
					<ProtectedString name="Source">--!strict
		--[=[
			--&gt; ["Kite : Types"]
		
			A registry of what actually exists on a Roblox Instance.
		
			This is the module that lets Kite *teach* you instead of throwing
			`Text is not a valid member of Frame` at runtime.
		
				```lua
				kite.create `Frame` { Text = `hi` }
				-- [Kite] Frame does not have a property called `Text`.
				--   did you mean: Visible?
				--   Frame draws nothing. Use a TextLabel for text.
				--   kite.help(`text`) walks through it.
				```
		
			Strict mode reads this table on every compile. Creative mode reads it
			to coerce shorthands. Performance mode skips it entirely.
		]=]
		
		local Util = require(script.Parent.Util)
		
		local Types = {}
		
		export type Range = { number }
		
		export type Class = {
			parent: string?,
			props: { [string]: string },
			events: { [string]: boolean },
			ranges: { [string]: Range },
			note: string?,
		}
		
		local classes: { [string]: Class } = {}
		
		local function define(name: string, parent: string?, props: { [string]: string }, events: { string }?, note: string?)
			local eventMap = {}
			if events then
				for _, event in events do
					eventMap[event] = true
				end
			end
		
			classes[name] = {
				parent = parent,
				props = props,
				events = eventMap :: { [string]: boolean },
				ranges = {},
				note = note,
			}
		end
		
		local function range(class: string, key: string, low: number, high: number)
			local entry = classes[class]
			if entry then
				entry.ranges[key] = { low, high }
			end
		end
		
		--&gt; ["Instance"]
		
		define("Instance", nil, {
			Name = "string",
			Archivable = "boolean",
		}, {
			"AncestryChanged",
			"AttributeChanged",
			"Changed",
			"ChildAdded",
			"ChildRemoved",
			"DescendantAdded",
			"DescendantRemoving",
			"Destroying",
		})
		
		define("Folder", "Instance", {})
		define("Configuration", "Instance", {})
		
		--&gt; ["GuiBase2d"]
		
		define("LayerCollector", "Instance", {
			Enabled = "boolean",
			ResetOnSpawn = "boolean",
			ZIndexBehavior = "Enum.ZIndexBehavior",
			DisplayOrder = "number",
			IgnoreGuiInset = "boolean",
			ScreenInsets = "Enum.ScreenInsets",
			ClipToDeviceSafeArea = "boolean",
			SafeAreaCompatibility = "Enum.SafeAreaCompatibility",
		})
		
		define("ScreenGui", "LayerCollector", {
			DisplayOrder = "number",
			IgnoreGuiInset = "boolean",
		})
		
		define("BillboardGui", "LayerCollector", {
			Active = "boolean",
			Adornee = "Instance",
			AlwaysOnTop = "boolean",
			Brightness = "number",
			ClipsDescendants = "boolean",
			DistanceLowerLimit = "number",
			DistanceStep = "number",
			DistanceUpperLimit = "number",
			ExtentsOffset = "Vector3",
			ExtentsOffsetWorldSpace = "Vector3",
			LightInfluence = "number",
			MaxDistance = "number",
			PlayerToHideFrom = "Instance",
			Size = "UDim2",
			SizeOffset = "Vector2",
			StudsOffset = "Vector3",
			StudsOffsetWorldSpace = "Vector3",
		})
		
		define("SurfaceGui", "LayerCollector", {
			Adornee = "Instance",
			Active = "boolean",
			AlwaysOnTop = "boolean",
			Brightness = "number",
			CanvasSize = "Vector2",
			ClipsDescendants = "boolean",
			Face = "Enum.NormalId",
			LightInfluence = "number",
			PixelsPerStud = "number",
			SizingMode = "Enum.SurfaceGuiSizingMode",
			ToolPunchThroughDistance = "number",
			ZOffset = "number",
		})
		
		define("GuiBase2d", "Instance", {
			AbsolutePosition = "Vector2",
			AbsoluteRotation = "number",
			AbsoluteSize = "Vector2",
			AutoLocalize = "boolean",
			RootLocalizationTable = "Instance",
			SelectionBehaviorDown = "Enum.SelectionBehavior",
			SelectionBehaviorLeft = "Enum.SelectionBehavior",
			SelectionBehaviorRight = "Enum.SelectionBehavior",
			SelectionBehaviorUp = "Enum.SelectionBehavior",
			SelectionGroup = "boolean",
			SelectionBehavior = "Enum.SelectionBehavior",
		})
		
		define("GuiObject", "GuiBase2d", {
			Active = "boolean",
			AnchorPoint = "Vector2",
			AutomaticSize = "Enum.AutomaticSize",
			BackgroundColor3 = "Color3",
			BackgroundTransparency = "number",
			BorderColor3 = "Color3",
			BorderMode = "Enum.BorderMode",
			BorderSizePixel = "number",
			ClipsDescendants = "boolean",
			LayoutOrder = "number",
			NextSelectionDown = "Instance",
			NextSelectionLeft = "Instance",
			NextSelectionRight = "Instance",
			NextSelectionUp = "Instance",
			Position = "UDim2",
			Rotation = "number",
			Selectable = "boolean",
			SelectionImageObject = "Instance",
			Size = "UDim2",
			SizeConstraint = "Enum.SizeConstraint",
			Transparency = "number",
			Visible = "boolean",
			ZIndex = "number",
		}, {
			"InputBegan",
			"InputChanged",
			"InputEnded",
			"MouseEnter",
			"MouseLeave",
			"MouseMoved",
			"MouseWheelBackward",
			"MouseWheelForward",
			"SelectionGained",
			"SelectionLost",
			"TouchLongPress",
			"TouchMoved",
			"TouchPan",
			"TouchPinch",
			"TouchRotate",
			"TouchSwipe",
			"TouchTap",
		})
		
		range("GuiObject", "BackgroundTransparency", 0, 1)
		range("GuiObject", "Transparency", 0, 1)
		range("GuiObject", "Rotation", -360, 360)
		
		define("Frame", "GuiObject", {
			Style = "Enum.FrameStyle",
		}, nil, "Frame draws a rectangle. It has no Text property; reach for TextLabel.")
		
		define("ScrollingFrame", "GuiObject", {
			AutomaticCanvasSize = "Enum.AutomaticSize",
			BottomImage = "string",
			CanvasPosition = "Vector2",
			CanvasSize = "UDim2",
			ElasticBehavior = "Enum.ElasticBehavior",
			HorizontalScrollBarInset = "Enum.ScrollBarInset",
			MidImage = "string",
			ScrollBarImageColor3 = "Color3",
			ScrollBarImageTransparency = "number",
			ScrollBarThickness = "number",
			ScrollingDirection = "Enum.ScrollingDirection",
			ScrollingEnabled = "boolean",
			TopImage = "string",
			VerticalScrollBarInset = "Enum.ScrollBarInset",
			VerticalScrollBarPosition = "Enum.VerticalScrollBarPosition",
		}, nil, "ScrollingFrame needs CanvasSize set or it will not scroll.")
		
		range("ScrollingFrame", "ScrollBarImageTransparency", 0, 1)
		
		define("CanvasGroup", "GuiObject", {
			GroupColor3 = "Color3",
			GroupTransparency = "number",
		}, nil, "CanvasGroup renders its children into one texture. Children do not inherit ZIndex across it.")
		
		range("CanvasGroup", "GroupTransparency", 0, 1)
		
		define("ViewportFrame", "GuiObject", {
			Ambient = "Color3",
			CurrentCamera = "Instance",
			ImageColor3 = "Color3",
			ImageTransparency = "number",
			LightColor = "Color3",
			LightDirection = "Vector3",
		})
		
		define("VideoFrame", "GuiObject", {
			Looped = "boolean",
			Playing = "boolean",
			TimePosition = "number",
			Video = "string",
			Volume = "number",
		})
		
		define("ImageLabel", "GuiObject", {
			Image = "string",
			ImageColor3 = "Color3",
			ImageRectOffset = "Vector2",
			ImageRectSize = "Vector2",
			ImageTransparency = "number",
			ResampleMode = "Enum.ResamplerMode",
			ScaleType = "Enum.ScaleType",
			SliceCenter = "Rect",
			SliceScale = "number",
			TileSize = "UDim2",
		})
		
		range("ImageLabel", "ImageTransparency", 0, 1)
		
		define("ImageButton", "ImageLabel", {
			HoverImage = "string",
			PressedImage = "string",
			SelectedImage = "string",
			Style = "Enum.ButtonStyle",
			AutoButtonColor = "boolean",

		--&gt; ["resolution"]
		
		local resolved: { [string]: { props: { [string]: string }, events: { [string]: boolean }, ranges: { [string]: Range }, chain: { string } } } =
			{}
		
		function Types.resolve(className: string)
			local hit = resolved[className]
			if hit then
				return hit
			end
		
			local props: { [string]: string } = {}
			local events: { [string]: boolean } = {}
			local ranges: { [string]: Range } = {}
			local chain: { string } = {}
		
			local cursor: string? = className
			local guard = 0
		
			while cursor and guard &lt; 32 do
				guard += 1
				table.insert(chain, cursor)
				local entry = classes[cursor]
		
				if not entry then
					break
				end
		
				for key, kind in entry.props do
					if props[key] == nil then
						props[key] = kind
					end
				end
		
				for key in entry.events do
					events[key] = true
				end
		
				for key, span in entry.ranges do
					if ranges[key] == nil then
						ranges[key] = span
					end
				end
		
				cursor = entry.parent
			end
		
			local out = {
				props = table.freeze(props),
				events = table.freeze(events),
				ranges = table.freeze(ranges),
				chain = table.freeze(chain),
			}
		
			resolved[className] = out
			return out
		end
		
		function Types.known(className: string): boolean
			return if classes[className] then true else false
		end
		
		--&gt; ["coercion"]
		
		local function coerceEnum(kind: string, value: any, strict: boolean): any?
			local name = string.match(kind, "^Enum%.(.+)$")
			if not name then
				return nil
			end
		
			if Util.kindOf(value) == "EnumItem" then
				return value
			end
		
			-- enum items that arrive as plain tables, which is what a test stub
			-- or a deserialized payload gives you
			if type(value) == "table" then
				local label = (value :: any).Name
				if type(label) == "string" then
					return value
				end
				return nil
			end
		
			if type(value) ~= "string" then
				return nil
			end
		
			-- strict mode wants the real thing, not a spelling of it
			if strict then
				local group = (Enum :: any)[name]
				return (group :: any)[value]
			end
		
			local group = (Enum :: any)[name]
			if not group then
				return nil
			end
		
			local hit = (group :: any)[value]
		
			if not hit then
				-- Accept `Left`, `left`, `Enum.TextXAlignment.Left`, `TextXAlignment.Left`
				local bare = string.match(value, "%.([%w_]+)$") or value
				for _, item in (group :: any):GetEnumItems() do
					if string.lower(item.Name) == string.lower(bare) then
						return item
					end
				end
			end
		
			return hit
		end
		
		local function coerceTo(kind: string, value: any, strict: boolean): any?
			if type(value) == "function" then
				return nil
			end
		
			local got = Util.kindOf(value)
		
			-- strict mode does not reshape your values. it tells you about them.
			if strict and got ~= kind then
				if not string.find(kind, "^Enum%.") then
					return nil
				end
			end
		
			if kind == "Color3" then
				if got == "Color3" then
					return value
				end
				if got == "string" then
					return Util.hex(value)
				end
				if got == "table" then
					return Util.hex(value)
				end
				return nil
			end
		
			if kind == "UDim2" then
				if got == "UDim2" then
					return value
				end
				if got == "number" or got == "string" or got == "table" then
					return Util.size(value)
				end
				return nil
			end
		
			if kind == "UDim" then
				if got == "UDim" then
					return value
				end
				if got == "number" then
					return UDim.new(0, value)
				end
				if got == "table" then
					return Util.padding(value)
				end
				return nil
			end
		
			if kind == "Vector2" then
				if got == "Vector2" then
					return value
				end
				if got == "table" then
					return Vector2.new((value :: any)[1] or 0, (value :: any)[2] or 0)
				end
				if got == "number" then
					return Vector2.new(value, value)
				end
				return nil
			end
		
			if kind == "Vector3" then
				if got == "Vector3" then
					return value
				end
				if got == "table" then
					return Vector3.new((value :: any)[1] or 0, (value :: any)[2] or 0, (value :: any)[3] or 0)
				end
				return nil
			end
		
			if kind == "ColorSequence" then
				if got == "ColorSequence" then
					return value
				end
				if got == "table" then
					local points = {}
					for index, color in value do
						local at = if type(index) == "number" then (index - 1) / math.max(1, #value - 1) else 0
						table.insert(points, ColorSequenceKeypoint.new(at, Util.hex(color)))
					end
					if #points == 1 then
						table.insert(points, ColorSequenceKeypoint.new(1, Util.hex((value :: any)[1])))
					end
					return ColorSequence.new(points)
				end
				return nil
			end
		
			if kind == "number" then
				if got == "number" then
					return value
				end
				if got == "string" then
					return tonumber(value)
				end
				return nil
			end
		
			if kind == "boolean" then
				if got == "boolean" then
					return value
				end
				return nil
			end
		
			if kind == "string" then
				if got == "string" then
					return value
				end
				if got == "number" then
					return tostring(value)
				end
				return nil
			end
		
			if kind == "Font" then
				if got == "Font" then
					return value
				end
				if got == "EnumItem" then
					return Font.fromEnum(value)
				end
				if got == "string" then
					return Font.fromName(value, Enum.FontWeight.Regular, Enum.FontStyle.Normal)
				end
				return nil
			end
		
			if kind == "Instance" then
				return if got == "Instance" then value else nil
			end
		
			if string.sub(kind, 1, 5) == "Enum." then
				return coerceEnum(kind, value, strict)
			end
		
			return value
		end
		
		Types.coerce = coerceTo
		
		--&gt; ["check"]
		-- Returns (ok, value, problem). `problem` is already written for humans.
		
		export type Problem = {
			key: string,
			message: string,
			hint: string?,
			level: string,
		}
		
		function Types.check(className: string, key: string, value: any, strict: boolean): (boolean, any, Problem?)
			local info = Types.resolve(className)
			local kind = info.props[key]
		
			if kind == nil then
				local nearest = Util.nearest(key, Util.keys(info.props))
		
				local hint
				if nearest then
					hint = `did you mean "{nearest}"?`
				elseif classes[className] and classes[className].note then
					hint = classes[className].note
				elseif info.events[key] then
					hint = `"{key}" is an event on {className}. Events go through kite.on, or assign the handler directly.`
				end
		
				return false, value, {
					key = key,
					message = `{className} has no property called "{key}"`,
					hint = hint,
					level = "error",
				}
			end
		
			if type(value) == "function" then
				return true, value, nil
			end
		
			local coerced = coerceTo(kind, value, strict)
		
			if coerced == nil then
				local got = Util.kindOf(value)
		
				return false, value, {
					key = key,
					message = `{className}.{key} expects {kind}, but you gave it {Util.show(value)}`,
					hint = if strict and got ~= kind
						then `{Util.title(got)} is not {kind}, and strict mode will not reshape it for you.`
						else `a {kind} looks like this in Kite: {Types.exampleOf(kind)}`,
					level = "error",
				}
			end
		
			local span = info.ranges[key]
		
			if span and Util.kindOf(coerced) == "number" then
				if coerced &lt; span[1] or coerced &gt; span[2] then
					return false, coerced, {
						key = key,
						message = `{className}.{key} should sit between {span[1]} and {span[2]}, you gave {Util.show(coerced)}`,
						hint = `clamp it: kite.clamp({coerced}, {span[1]}, {span[2]})`,
						level = "error",
					}
				end
			end
		
			return true, coerced, nil
		end
		
		--&gt; ["fit"]
		-- A binding writes on every frame, so this does not get to be clever. It
		-- resolves the property kind once per Class.property, then stays out of
		-- the way. Anything it cannot fix is handed back untouched.
		
		local kindCache: { [string]: any } = {}
		
		function Types.fit(className: string, key: string, value: any): any
			if type(value) == "function" then
				return value
			end
		
			local cacheKey = `{className}.{key}`
			local cached = kindCache[cacheKey]
		
			local kind: string?
		
			if cached == nil then
				local info = Types.resolve(className)
				kind = info.props[key]
				kindCache[cacheKey] = if kind then kind else false
			elseif cached ~= false then
				kind = cached :: string
			end
		
			if kind == nil then
				return value
			end
		
			return coerceTo(kind :: string, value, false) or value
		end
		
		function Types.exampleOf(kind: string): string
			if kind == "UDim2" then
				return "UDim2.fromOffset(200, 46)  or  kite.size(200, 46)"
			end
			if kind == "UDim" then
				return "UDim.new(0, 8)  or  8"
			end
			if kind == "Vector2" then
				return "Vector2.new(0.5, 0.5)  or  kite.anchor(0.5, 1)"
			end
			if kind == "Color3" then
				return `Color3.fromHex("3ddad7")  or  "#3ddad7"`
			end
			if kind == "ColorSequence" then
				return `gradient = \{ "#112126", "#0d181b" \}`
			end
			if kind == "Font" then
				return `Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Medium)`
			end
			if string.sub(kind, 1, 5) == "Enum." then
				return `{kind}.{Util.title(string.match(kind, "%.(.+)$") or "Value")}  or  "{string.match(kind, "%.(.+)$")}"`
			end
			return `a {kind}`
		end
		
		--&gt; ["events"]
		
		--&gt; ["teach"]
		-- Kite ships with the classes it knows. When you meet one it does not,
		-- say so once and the linter starts helping with it too.
		
		function Types.learn(className: string, parent: string?, props: { [string]: string }, events: { string }?)
			define(className, parent or "Instance", props, events)
		
			-- drop the memoized chains so the new class shows up everywhere
			for key in resolved do
				resolved[key] = nil
			end
		end
		
		function Types.isEvent(className: string, key: string): boolean
			local info = Types.resolve(className)
			return info.events[key] == true
		end
		
		function Types.hasProperty(className: string, key: string): boolean
			return Types.resolve(className).props[key] ~= nil
		end
		
		return Types
		</ProtectedString>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXb2de63520eb753d9">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Util</string>
					<ProtectedString name="Source">--!strict
		--[=[
			--&gt; ["Kite : Util"]
		
			Small helpers shared across the package.
			Nothing here is reactive. Nothing here touches instances.
		
			--&gt; ["why this exists"]
			Kite wants to *guide* you. That means error messages have to name the
			thing you actually wrote, not a raw Luau type code. This module is the
			vocabulary those messages are built from.
		]=]
		
		local Util = {}
		
		export type Entry = { [any]: any }
		
		--&gt; ["naming"]
		-- Roblox's typeof reads a table's `__type` field. Outside Studio it does
		-- not, so Kite asks once, here, and everything else reads through this.
		
		function Util.kindOf(value: any): string
			local kind = typeof(value)
		
			if kind == "table" then
				local meta = getmetatable(value)
		
				if type(meta) == "table" then
					local named = (meta :: any).__type
		
					if type(named) == "string" then
						return named :: string
					end
				end
			end
		
			return kind
		end
		
		function Util.typeName(value: any): string
			local kind = typeof(value)
		
			if kind == "Instance" then
				return value.ClassName
			end
		
			if kind == "table" then
				local meta = getmetatable(value)
				if type(meta) == "table" and type(meta.__type) == "string" then
					return meta.__type :: string
				end
		
				if type(meta) == "table" and type(meta.__index) == "table" then
					local index = meta.__index
					local own = (index :: any)._type
					if type(own) == "string" then
						return own :: string
					end
				end
		
				return "table"
			end
		
			return kind
		end
		
		--&gt; ["show"]
		-- Short, human rendering of a value for error text. Never throws.
		
		function Util.show(value: any): string
			local kind = typeof(value)
		
			if kind == "string" then
				return `"{value}"`
			end
		
			if kind == "number" then
				if value % 1 == 0 then
					return tostring(value)
				end
				return string.format("%.3f", value)
			end
		
			if kind == "Instance" then
				return `{value.ClassName}("{value.Name}")`
			end
		
			if kind == "table" then
				local count = 0
				for _ in value do
					count += 1
					if count &gt; 4 then
						break
					end
				end
				return `table({count}+)`
			end
		
			return tostring(value)
		end
		
		--&gt; ["math"]
		
		function Util.clamp(value: number, low: number, high: number): number
			if value &lt; low then
				return low
			end
			if value &gt; high then
				return high
			end
			return value
		end
		
		function Util.lerp(from: number, to: number, alpha: number): number
			return from + (to - from) * alpha
		end
		
		function Util.map(value: number, inLow: number, inHigh: number, outLow: number, outHigh: number): number
			if inHigh == inLow then
				return outLow
			end
			local alpha = (value - inLow) / (inHigh - inLow)
			return Util.lerp(outLow, outHigh, alpha)
		end
		
		function Util.round(value: number, places: number?): number
			local factor = 10 ^ (places or 0)
			return math.round(value * factor) / factor
		end
		
		--&gt; ["equality"]
		-- Kite treats NaN == NaN as true because a spring settling on NaN should not
		-- scream at you forever.
		
		function Util.equal(left: any, right: any): boolean
			if left == right then
				return true
			end
		
			local kind = typeof(left)
			if kind ~= typeof(right) then
				return false
			end
		
			if kind == "number" then
				return left ~= left and right ~= right
			end
		
			if kind == "table" then
				local meta = getmetatable(left)
				if type(meta) == "table" and type((meta :: any).__eq) == "function" then
					return left == right
				end
		
				for key, value in left do
					if not Util.equal(value, (right :: any)[key]) then
						return false
					end
				end
		
				for key in right do
					if (left :: any)[key] == nil then
						return false
					end
				end
		
				return true
			end
		
			return false
		end
		
		--&gt; ["color"]
		-- `#3ddad7`, `3ddad7`, `#3dd`, Color3, or { r, g, b } in 0..1.
		
		function Util.hex(source: any): Color3
			local kind = Util.kindOf(source)
		
			if kind == "Color3" then
				return source
			end
		
			if kind == "table" then
				local r = (source :: any)[1] or (source :: any).R or 0
				local g = (source :: any)[2] or (source :: any).G or 0
				local b = (source :: any)[3] or (source :: any).B or 0
				return Color3.new(r, g, b)
			end
		
			if kind ~= "string" then
				error(`[Kite] Util.hex cannot read {Util.show(source)}`, 2)
			end
		
			local text = source :: string
			if string.sub(text, 1, 1) == "#" then
				text = string.sub(text, 2)
			end
		
			if #text == 3 then
				local r = string.sub(text, 1, 1)
				local g = string.sub(text, 2, 2)
				local b = string.sub(text, 3, 3)
				text = r .. r .. g .. g .. b .. b
			end
		
			if #text ~= 6 then
				error(`[Kite] "{text}" is not a 6 digit hex color`, 2)
			end
		
			return Color3.fromHex(text)
		end
		
		--&gt; ["layout"]
		-- Creative mode shorthands land here.
		
		function Util.udim2(scaleX, offsetX, scaleY, offsetY): UDim2
			return UDim2.new(scaleX, offsetX, scaleY, offsetY)
		end
		
		function Util.size(source: any): UDim2
			local kind = Util.kindOf(source)
		
			if kind == "UDim2" then
				return source
			end
		
			if kind == "string" then
				if source == "fill" then
					return UDim2.fromScale(1, 1)
				end
				if source == "full" then
					return UDim2.fromScale(1, 1)
				end
				if source == "auto" then
					return UDim2.fromOffset(0, 0)
				end
				error(`[Kite] unknown size shorthand "{source}"`, 3)
			end
		
			if kind == "number" then
				return UDim2.fromOffset(source, source)
			end
		
			if kind == "table" then
				local entry = source :: Util.Entry
				if entry.x ~= nil or entry.y ~= nil then
					return UDim2.new(
						if entry.x then 1 else 0,
						if typeof(entry.x) == "number" then entry.x else 0,
						if entry.y then 1 else 0,
						if typeof(entry.y) == "number" then entry.y else 0
					)
				end
				local total = #entry
		
				if total == 2 then
					-- { 220, 120 } reads as width and height in pixels
					return UDim2.new(0, entry[1] or 0, 0, entry[2] or 0)
				end
		
				if total == 3 then
					return UDim2.new(entry[1] or 0, entry[2] or 0, entry[3] or 0, 0)
				end
		
				return UDim2.new(entry[1] or 0, entry[2] or 0, entry[3] or 0, entry[4] or 0)
			end
		
			error(`[Kite] Util.size cannot read {Util.show(source)}`, 2)
		end
		
		function Util.padding(source: any): UDim
			local kind = Util.kindOf(source)
		
			if kind == "UDim" then
				return source
			end
			if kind == "number" then
				return UDim.new(0, source)
			end
			if kind == "table" then
				local entry = source :: Util.Entry
				if entry[1] ~= nil then
					return UDim.new(entry[1], entry[2] or 0)
				end
				return UDim.new(entry.scale or 0, entry.offset or 0)
			end
			error(`[Kite] Util.padding cannot read {Util.show(source)}`, 2)
		end
		
		--&gt; ["tables"]
		
		function Util.freeze&lt;T&gt;(value: T): T
			if type(value) == "table" and not table.isfrozen(value) then
				table.freeze(value)
			end
			return value
		end
		
		function Util.count(source: { [any]: any }): number
			local total = 0
			for _ in source do
				total += 1
			end
			return total
		end
		
		function Util.keys&lt;T&gt;(source: { [T]: any }): { T }
			local out = {}
			for key in source do
				table.insert(out, key)
			end
			return out
		end
		
		function Util.sorted&lt;T&gt;(source: { T }, by: ((T) -&gt; any)?): { T }
			local copy = table.clone(source) :: { T }
		
			if by then
				table.sort(copy, function(left, right)
					return (by :: any)(left) &lt; (by :: any)(right)
				end)
			else
				table.sort(copy)
			end
		
			return copy
		end
		
		--&gt; ["strings"]
		
		function Util.wrap(text: string, width: number): { string }
			local lines = {}
			local line = ""
		
			for word in string.gmatch(text, "%S+") do
				if #line == 0 then
					line = word
				elseif #line + 1 + #word &lt;= width then
					line ..= " " .. word
				else
					table.insert(lines, line)
					line = word
				end
			end
		
			if #line &gt; 0 then
				table.insert(lines, line)
			end
		
			return lines
		end
		
		function Util.pad(text: string, width: number): string
			if #text &gt;= width then
				return text
			end
			return text .. string.rep(" ", width - #text)
		end
		
		function Util.title(text: string): string
			local head = string.sub(text, 1, 1)
			return string.upper(head) .. string.sub(text, 2)
		end
		
		--&gt; ["suggestions"]
		-- Levenshtein distance, capped. Powers `did you mean`.
		
		function Util.distance(left: string, right: string): number
			if left == right then
				return 0
			end
		
			local leftLength = #left
			local rightLength = #right
		
			if leftLength == 0 then
				return rightLength
			end
			if rightLength == 0 then
				return leftLength
			end
		
			local previous = table.create(rightLength + 1, 0)
			local current = table.create(rightLength + 1, 0)
		
			for index = 0, rightLength do
				previous[index + 1] = index
			end
		
			for i = 1, leftLength do
				current[1] = i
		
				for j = 1, rightLength do
					local cost = if string.sub(left, i, i) == string.sub(right, j, j) then 0 else 1
					current[j + 1] = math.min(
						current[j] + 1,
						previous[j + 1] + 1,
						previous[j] + cost
					)
				end
		
				previous, current = current, previous
			end
		
			return previous[rightLength + 1]
		end
		
		function Util.nearest(needle: string, haystack: { string }): string?
			local best: string? = nil
			local bestScore = math.huge
		
			for _, candidate in haystack do
				local score = Util.distance(string.lower(needle), string.lower(candidate))
				if score &lt; bestScore then
					bestScore = score
					best = candidate
				end
			end
		
			if bestScore &gt; math.max(3, math.floor(#needle / 2)) then
				return nil
			end
		
			return best
		end
		
		--&gt; ["instances"]
		
		function Util.isInstance(value: any): boolean
			return typeof(value) == "Instance"
		end
		
		function Util.childrenOf(instance: Instance): { Instance }
			local out = {}
			for _, child in instance:GetChildren() do
				table.insert(out, child)
			end
			return out
		end
		
		return Util
		</ProtectedString>

		--&gt; ["input"]
		-- Keys are wired once, outside the tree.
		
		local UserInputService = game:GetService("UserInputService")
		
		UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
			if processed then
				return
			end
		
			if input.KeyCode == Enum.KeyCode.Quote then
				open(not open())
		
				if open() then
					box():CaptureFocus()
				else
					box():ReleaseFocus()
					suggestions({})
				end
		
				return
			end
		
			if not open() then
				return
			end
		
			if input.KeyCode == Enum.KeyCode.Escape then
				open(false)
				box():ReleaseFocus()
				suggestions({})
				return
			end
		
			if input.KeyCode == Enum.KeyCode.Tab then
				complete()
				return
			end
		
			if input.KeyCode == Enum.KeyCode.Up then
				move(-1)
				return
			end
		
			if input.KeyCode == Enum.KeyCode.Down then
				move(1)
			end
		end)
		
		--&gt; ["typing"]
		-- Refs hand you the instance the moment it exists, so the connection is
		-- made once and owned by nothing in particular.
		
		task.spawn(function()
			local input = box:wait() :: TextBox
		
			input:GetPropertyChangedSignal("Text"):Connect(function()
				refresh(input.Text)
			end)
		end)
		
		--&gt; ["build"]
		
		Kite.mode("creative")
		
		local handle = Kite.mount(CommandBar)
		
		--&gt; ["guidance"]
		-- The linter reads your own tree, in your own mode, and answers like a
		-- person. Uncomment it and read the output.
		
		-- print(Kite.strict(CommandBar):text())
		-- print(Kite.performance(CommandBar):text())
		-- Kite.help(`keys`)
		
		say("ok", "Kite command bar online")
		say("info", "press Quote to open it")
		
		return handle
		</ProtectedString>

					<string name="Name">Mount</string>
					<ProtectedString name="Source">--!strict
		--[=[
			--&gt; ["Kite : Mount"]
		
			Takes a plan and builds the real thing.
		
			The mount order is deliberate:
		
				1. create the instance
				2. write every static property
				3. mount children
				4. attach attributes, tags, and refs
				5. parent it, once, last
				6. open bindings and events
		
			Parenting last is what keeps Roblox from laying the tree out once per
			property. Bindings open after parenting so the first frame is already
			correct.
		
			--&gt; ["one effect per instance"]
			Every dynamic property on an instance shares a single effect. Ten
			animated properties on one frame is one node in the graph, not ten.
		]=]
		
		local Util = require(script.Parent.Util)
		local Scope = require(script.Parent.Scope)
		local Graph = require(script.Parent.Graph)
		local Config = require(script.Parent.Config)
		local Types = require(script.Parent.Types)
		local Compiler = require(script.Parent.Compiler)
		
		local CollectionService = game:GetService("CollectionService")
		
		export type Handle = {
			kind: string,
			instance: Instance,
			scope: Scope.Scope,
			alive: boolean,
			destroy: (Handle) -&gt; (),
			find: (Handle, string) -&gt; Instance?,
		}
		
		local Mount = {}
		
		Mount.mounts = 0 :: number
		Mount.instances = 0 :: number
		Mount.writes = 0 :: number
		Mount.bindings = 0 :: number
		Mount.events = 0 :: number
		Mount.cachedHome = nil :: Instance?
		
		local handlers: { [string]: (any, Instance, Scope.Scope, any, number?) -&gt; any } = {}
		
		function Mount.register(kind: string, fn: (any, Instance, Scope.Scope, any, number?) -&gt; any)
			handlers[kind] = fn
		end
		
		--&gt; ["elements"]
		
		function Mount.create(className: string): ({ [any]: any }) -&gt; any
			if type(className) ~= "string" then
				error(
					`[Kite] kite.create needs a class name string, you gave it {Util.show(className)}.\n`
						.. `  try: kite.create "Frame" \{ Size = UDim2.fromOffset(100, 100) \}`,
					2
				)
			end
		
			return function(props: { [any]: any }?): any
				return {
					kind = "element",
					class = className,
					props = props or {},
				}
			end
		end
		
		function Mount.element(className: string, props: { [any]: any }?): any
			return Mount.create(className)(props or {})
		end
		
		function Mount.from(instance: Instance): any
			return {
				kind = "instance",
				node = instance,
			}
		end
		
		--&gt; ["instantiate"]
		
		local function applyDynamics(instance: Instance, dynamics: { { [number]: any } })
			local total = #dynamics
			local last = table.create(total, nil)
		
			Graph.effect(function()
				for index = 1, total do
					local entry = dynamics[index]
					local value = entry[2]()
		
					if not Util.equal(value, last[index]) then
						last[index] = value
						instance[entry[1]] = Types.fit(instance.ClassName, entry[1], value)
						Mount.writes += 1
					end
				end
			end)
		
			Mount.bindings += 1
		end
		
		local function applyEvents(instance: Instance, events: { { [number]: any } })
			for index = 1, #events do
				local entry = events[index]
				local signal = (instance :: any)[entry[1]]
		
				-- anything with a Connect method counts, which covers Roblox
				-- signals, Kite signals, and whatever your own code gives you
				local connectable = typeof(signal) == "RBXScriptSignal"
					or (type(signal) == "table" and type((signal :: any).Connect) == "function")
		
				if not connectable then
					warn(`[Kite] {instance.ClassName} has no event called "{entry[1]}", so the handler was skipped.`)
					continue
				end
		
				local connection = signal:Connect(entry[2])
				Scope.cleanup(function()
					connection:Disconnect()
				end)
		
				Mount.events += 1
			end
		end
		
		function Mount.instantiate(plan: any, parent: Instance, scope: Scope.Scope, index: number?): Instance?
			if plan == nil then
				return nil
			end
		
			local kind = plan.kind
		
			if kind == "element" then
				local instance: Instance = Instance.new(plan.class :: string)
				Mount.instances += 1
		
				Scope.cleanup(function()
					if instance.Parent ~= nil or true then
						instance:Destroy()
					end
				end)
		
				if plan.statics then
					local statics = plan.statics
					for entry = 1, #statics do
						local pair = statics[entry]
						instance[pair[1]] = pair[2]
						Mount.writes += 1
					end
				end
		
				if plan.attrs then
					for key, value in plan.attrs do
						instance:SetAttribute(key, value)
					end
				end
		
				if plan.tags then
					for _, tag in plan.tags do
						CollectionService:AddTag(instance, tag)
					end
				end
		
				if plan.children then
					for childIndex, childPlan in plan.children do
						Mount.instantiate(childPlan, instance, scope, childIndex)
					end
				end
		
				instance.Parent = parent
		
				if plan.dynamics then
					applyDynamics(instance, plan.dynamics)
				end
		
				if plan.events then
					applyEvents(instance, plan.events)
				end
		
				if plan.refs then
					for _, ref in plan.refs do
						if type(ref) == "function" then
							ref(instance)
						elseif type(ref) == "table" then
							if type((ref :: any).set) == "function" then
								(ref :: any).set(instance)
							else
								(ref :: any).current = instance
							end
						end
					end
				end
		
				if plan.effects then
					for _, effect in plan.effects do
						Graph.effect(function()
							return effect(instance)
						end)
					end
				end
		
				return instance
			end
		
			if kind == "instance" then
				local instance = plan.node :: Instance
				instance.Parent = parent
				return instance
			end
		
			local handler = handlers[kind]
		
			if handler then
				return handler(plan.node or plan, parent, scope, Mount.instantiate, index)
			end
		
			-- unknown node: maybe it is a plain instance that fell through
			if typeof(plan) == "Instance" then
				plan.Parent = parent
				return plan
			end
		
			error(`[Kite] cannot mount a node of kind "{tostring(kind)}". kite.help("nodes") lists them.`, 2)
		end
		
		--&gt; ["mount"]
		
		local Handle = {} :: { [string]: any }
		Handle.__type = "Kite.Handle"
		Handle.__index = Handle
		
		function Handle.destroy(self: Handle)
			if not self.alive then
				return
			end
			self.alive = false
			Scope.destroy(self.scope)
		end
		
		function Handle.find(self: Handle, name: string): Instance?
			return self.instance:FindFirstChild(name, true)
		end
		
		function Handle.wait(self: Handle, name: string, timeout: number?): Instance?
			return self.instance:WaitForChild(name, timeout or 5)
		end
		
		function Handle:Destroy()
			Handle.destroy(self)
		end
		
		function Handle:__tostring(): string
			return `Kite.Handle({self.instance.ClassName})`
		end
		
		--&gt; ["default parent"]
		-- You almost always want PlayerGui. Say it once here and never again.
		
		function Mount.home(): Instance
			if Mount.cachedHome and Mount.cachedHome.Parent ~= nil then
				return Mount.cachedHome
			end
		
			local players = (game :: any):GetService("Players")
			local player = players.LocalPlayer
		
			if player == nil then
				error("[Kite] kite.mount needs a parent, or a LocalPlayer to borrow PlayerGui from", 3)
			end
		
			local playerGui = player:WaitForChild("PlayerGui")
			Mount.cachedHome = playerGui
		
			return playerGui
		end
		
		function Mount.go(build: () -&gt; any, options: { mode: string?, name: string?, batch: boolean?, parent: Instance? }?): Handle
			if type(build) ~= "function" then
				error(
					"[Kite] kite.go wants a function that returns a tree.\n"
						.. "  kite.go(function()\n"
						.. "    return kite.create `ScreenGui` { ... }\n"
						.. "  end)",
					2
				)
			end
		
			--&gt; ["the builder runs inside the scope"]
			-- Sources, derives, and effects made in the builder belong to the tree,
			-- not to the script, so destroying the handle stops all of them.
		
			local scope = Scope.create((options and options.name) or "go")
		
			Scope.push(scope)
			local ok, element = pcall(build)
			Scope.pop()
		
			if not ok then
				Scope.destroy(scope)
				error(element, 0)
			end
		
			if element == nil then
				Scope.destroy(scope)
				error("[Kite] the function you gave kite.go returned nothing. return the tree you built.", 2)
			end
		
			return Mount.mount(element, (options and options.parent) or nil, options, scope)
		end
		
		function Mount.mount(
			element: any,
			parent: Instance?,
			options: { mode: string?, name: string?, batch: boolean? }?,
			preset: Scope.Scope?
		): Handle
			if parent == nil then
				parent = Mount.home()
			end
		
			if typeof(parent) == "table" and parent ~= nil and (parent :: any).kind == "element" then
				error(
					"[Kite] you passed a Kite element where the parent instance goes.\n"
						.. "  kite.mount(element, parent)  -- parent is a real Instance, like PlayerGui",
					2
				)
			end
		
			local previous = Config.mode
		
			if options and options.mode then
				Config.apply(options.mode)
			end
		
			local scope = preset or Scope.create((options and options.name) or "mount")
			Scope.push(scope)
		
			local plan = Compiler.plan(element)
			local instance = Mount.instantiate(plan, parent :: Instance, scope, 1)
		
			Scope.pop()
		
			if options and options.mode then
				Config.apply(previous)
			end
		
			Mount.mounts += 1
		
			if instance == nil then
				error("[Kite] the tree mounted to nothing. kite.help(\"mount\") shows the shapes that work.", 2)
			end
		
			local handle = {
				kind = "handle",
				instance = instance,
				scope = scope,
				alive = true,
			}
		
			return setmetatable(handle, Handle) :: any
		end
		
		--&gt; ["hydrate"]
		-- Mounts onto an instance that already exists, so Kite can take over one
		-- screen built in Studio without rebuilding it.
		
		function Mount.hydrate(element: any, instance: Instance, options: { name: string? }?): Handle
			local scope = Scope.create((options and options.name) or "hydrate")
			Scope.push(scope)
		
			local plan = Compiler.plan(element)
		
			if plan.kind ~= "element" then
				error("[Kite] hydrate expects a single element as its first argument.", 2)
			end
		
			if plan.statics then
				for _, pair in plan.statics do
					instance[pair[1]] = pair[2]
				end
			end
		
			if plan.children then
				for index, childPlan in plan.children do
					Mount.instantiate(childPlan, instance, scope, index)
				end
			end
		
			if plan.dynamics then
				applyDynamics(instance, plan.dynamics)
			end
		
			if plan.events then
				applyEvents(instance, plan.events)
			end
		
			Scope.pop()
		
			Mount.mounts += 1
		
			return setmetatable({
				kind = "handle",
				instance = instance,
				scope = scope,
				alive = true,
			}, Handle) :: any
		end
		
		--&gt; ["ref"]
		
		function Mount.ref(): any
			local ref = {
				kind = "ref",
				current = nil :: Instance?,
			}
		
			function ref.set(instance: Instance)
				ref.current = instance
			end
		
			function ref.get(): Instance?
				return ref.current
			end
		
			function ref.wait(): Instance
				local started = os.clock()
				while ref.current == nil and os.clock() - started &lt; 5 do
					task.wait()
				end
				return ref.current :: Instance
			end
		
			return setmetatable(ref, {
				__type = "Kite.Ref",
				__call = function(self: any)
					return self.current
				end,
				__index = ref,
			})
		end
		
		--&gt; ["portal"]
		-- Mounts a tree somewhere else entirely, while it stays owned by the scope
		-- it was written in. Used for tooltips, drag layers, and world space UI.
		
		function Mount.portal(element: any, target: Instance): any
			return {
				kind = "portal",
				element = element,
				target = target,
			}
		end
		
		Mount.register("portal", function(node, _parent, scope, instantiate)
			local handle = Mount.mount(node.element, node.target)
			Scope.cleanup(function()
				handle:destroy()
			end)
			return handle.instance
		end)
		
		--&gt; ["stats"]
		
		function Mount.stats()
			return {
				mounts = Mount.mounts,
				instances = Mount.instances,
				writes = Mount.writes,
				bindings = Mount.bindings,
				events = Mount.events,
			}
		end
		
		function Mount.reset()
			Mount.mounts = 0
			Mount.instances = 0
			Mount.writes = 0
			Mount.bindings = 0
			Mount.events = 0
		end
		
		return Mount
		</ProtectedString>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXe6221ba747a00964">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Profiler</string>
					<ProtectedString name="Source">--!strict
		--[=[
			--&gt; ["Kite : Profiler"]
		
			Counters that are already in the package, waiting to be read. No hooks
			are installed when you are not profiling: the counters are plain number
			increments on paths Kite walks anyway.
		
			```lua
			kite.profile(true)
		
			local profiler = kite.profiler()
			print(profiler:text())
		
			-- or measure one thing
			local timing = kite.measure(`build the shop`, function()
				buildShop()
			end)
			print(timing.milliseconds)
			```
		
			--&gt; ["what is counted"]
			```text
			graph     nodes, reads, writes, computes, effects, batches, flushes
			mount     mounts, instances, writes, bindings, events
			compile   compiled, cache hits, cached plans, sugar expanded
			keys      created, reused, destroyed, moves
			motion    frames, steps, live motions, connections
			```
		]=]
		
		local Util = require(script.Parent.Util)
		
		local Profiler = {}
		
		Profiler.enabled = false
		Profiler.started = os.clock()
		Profiler.runs = 0 :: number
		Profiler.milliseconds = 0 :: number
		
		local marks: { { label: string, at: number, ms: number? } } = {}
		
		--&gt; ["toggle"]
		
		function Profiler.enable(state: boolean?)
			Profiler.enabled = if state == nil then true else state
		
			if Profiler.enabled then
				Profiler.started = os.clock()
			end
		end
		
		function Profiler.isEnabled(): boolean
			return Profiler.enabled
		end
		
		--&gt; ["measure"]
		--- Times one call. Returns the value the call returned plus how long it took.
		---
		--- Example:
		--- ```lua
		--- const built = kite.measure(`shop`, function() return buildShop() end)
		--- print(built.milliseconds, built.value)
		--- ```
		
		function Profiler.measure&lt;T...&gt;(label: string, fn: (T...) -&gt; any, ...: T...): any
			local at = os.clock()
			local results = table.pack(pcall(fn, ...))
			local took = (os.clock() - at) * 1000
		
			if not results[1] then
				error(results[2], 2)
			end
		
			Profiler.runs += 1
			Profiler.milliseconds += took
		
			table.insert(marks, { label = label, at = at, ms = took })
		
			if #marks &gt; 64 then
				table.remove(marks, 1)
			end
		
			return setmetatable({
				label = label,
				milliseconds = took,
				value = results[2],
				n = results.n - 1,
			}, {
				__type = "Kite.Measure",
				__tostring = function(self: any)
					return `{label} took {string.format("%.3f", took)}ms`
				end,
			}) :: any
		end
		
		function Profiler.marks(): { { label: string, at: number, ms: number? } }
			return table.clone(marks)
		end
		
		--&gt; ["snapshot"]
		
		function Profiler.snapshot()
			local Graph = require(script.Parent.Graph)
			local Mount = require(script.Parent.Mount)
			local Compiler = require(script.Parent.Compiler)
			local Keys = require(script.Parent.Keys)
			local Spring = require(script.Parent.Spring)
			local Component = require(script.Parent.Component)
			local Scope = require(script.Parent.Scope)
		
			return {
				enabled = Profiler.enabled,
				uptime = os.clock() - Profiler.started,
				graph = Graph.stats(),
				mount = Mount.stats(),
				compile = Compiler.stats(),
				keys = Keys.stats(),
				motion = Spring.stats(),
				component = Component.stats(),
				scope = Scope.stats(),
				measure = {
					runs = Profiler.runs,
					milliseconds = Profiler.milliseconds,
				},
			}
		end
		
		function Profiler.reset()
			local Graph = require(script.Parent.Graph)
			local Mount = require(script.Parent.Mount)
			local Compiler = require(script.Parent.Compiler)
			local Keys = require(script.Parent.Keys)
			local Spring = require(script.Parent.Spring)
		
			Graph.reset()
			Mount.reset()
			Compiler.reset()
			Keys.reset()
			Spring.reset()
		
			Profiler.runs = 0
			Profiler.milliseconds = 0
			table.clear(marks)
		end
		
		--&gt; ["report"]
		
		function Profiler.report(): any
			local out = {} :: { [string]: any }
			out.snapshot = function()
				return Profiler.snapshot()
			end
			out.text = function()
				return Profiler.text()
			end
			out.html = function()
				return Profiler.html()
			end
			out.json = function()
				return Profiler.json()
			end
			out.reset = function()
				Profiler.reset()
			end
		
			return out
		end
		
		function Profiler.text(): string
			local snap = Profiler.snapshot()
			local lines = {}
		
			local function row(group: string, key: string, value: any)
				table.insert(lines, `  {Util.pad(group, 9)}{Util.pad(key, 12)}{value}`)
			end
		
			table.insert(lines, "Kite profiler")
			table.insert(lines, `  uptime {string.format("%.3f", snap.uptime)}s` .. (if not snap.enabled then "   (profiling is off, counts still accumulate)" else ""))
			table.insert(lines, "")
		
			row("graph", "nodes", snap.graph.nodes)
			row("graph", "reads", snap.graph.reads)
			row("graph", "writes", snap.graph.writes)
			row("graph", "computes", snap.graph.computes)
			row("graph", "effects", snap.graph.effects)
			row("graph", "batches", snap.graph.batches)
			row("graph", "flushes", snap.graph.flushes)
			row("graph", "epoch", snap.graph.epoch)
			table.insert(lines, "")
		
			row("mount", "mounts", snap.mount.mounts)
			row("mount", "instances", snap.mount.instances)
			row("mount", "writes", snap.mount.writes)
			row("mount", "bindings", snap.mount.bindings)
			row("mount", "events", snap.mount.events)
			table.insert(lines, "")
		
			row("compile", "compiled", snap.compile.compiled)
			row("compile", "cacheHits", snap.compile.cacheHits)
			row("compile", "cached", snap.compile.cached)
			row("compile", "sugar", snap.compile.sugar)
			table.insert(lines, "")
		
			row("keys", "created", snap.keys.created)
			row("keys", "reused", snap.keys.reused)
			row("keys", "destroyed", snap.keys.destroyed)
			row("keys", "moves", snap.keys.moves)
			table.insert(lines, "")
		
			row("motion", "frames", snap.motion.frames)
			row("motion", "steps", snap.motion.steps)
			row("motion", "live", snap.motion.motions)
			row("motion", "connections", snap.motion.connections)
			table.insert(lines, "")
		
			row("component", "defined", snap.component.defined)
			row("component", "built", snap.component.built)
			table.insert(lines, "")
		
			row("scope", "scopes", snap.scope.scopes)
			row("scope", "cleanups", snap.scope.cleanups)
			table.insert(lines, "")
		
			row("measure", "runs", snap.measure.runs)
			row("measure", "total ms", string.format("%.3f", snap.measure.milliseconds))
		
			if #marks &gt; 0 then
				table.insert(lines, "")
				table.insert(lines, "  last marks")
				for index = math.max(1, #marks - 7), #marks do
					local mark = marks[index]
					table.insert(lines, `    {Util.pad(mark.label, 28)}{string.format("%.3f", mark.ms or 0)}ms`)
				end
			end
		
			return table.concat(lines, "\n")
		end
		
		function Profiler.json(): string
			local snap = Profiler.snapshot()
		
			local function dump(value: any, indent: number): string
				local pad = string.rep("  ", indent)
		
				if type(value) ~= "table" then
					if type(value) == "string" then
						return `"{value}"`
					end
					return tostring(value)
				end
		
				local parts = {}
				for key, inner in value do
					table.insert(parts, `{pad}  "{tostring(key)}": {dump(inner, indent + 1)}`)
				end
		
				if #parts == 0 then
					return "{}"
				end
		
				return "{\n" .. table.concat(parts, ",\n") .. `\n{pad}}`
			end
		
			return dump(snap, 0)
		end
		
		function Profiler.html(): string
			local snap = Profiler.snapshot()
		
			local groups = {
				{ "graph", snap.graph },
				{ "mount", snap.mount },
				{ "compile", snap.compile },
				{ "keys", snap.keys },
				{ "motion", snap.motion },
				{ "component", snap.component },
				{ "scope", snap.scope },
			}
		
			local cards = {}
		
			for _, group in groups do
				local name = group[1] :: string
				local values = group[2] :: { [string]: any }
				local rows = {}
		
				for key, value in Util.sorted(Util.keys(values)) do
					table.insert(rows, string.format(
						[[          &lt;tr&gt;&lt;td&gt;%s&lt;/td&gt;&lt;td class="num"&gt;%s&lt;/td&gt;&lt;/tr&gt;]],
						tostring(key),
						tostring((values :: any)[key])
					))
				end
		
				table.insert(cards, string.format(
					[[      &lt;div class="card"&gt;
		        &lt;h2&gt;%s&lt;/h2&gt;
		        &lt;table&gt;
		%s
		        &lt;/table&gt;
		      &lt;/div&gt;]],
					name,
					table.concat(rows, "\n")
				))
			end
		
			return string.format(
				[[&lt;!doctype html&gt;
		&lt;html&gt;
		&lt;head&gt;
		&lt;meta charset="utf-8"&gt;
		&lt;title&gt;Kite profiler&lt;/title&gt;
		&lt;style&gt;
		  body { background: #0d181b; color: #eeeeee; font: 13px/1.5 ui-monospace, monospace; margin: 24px; }
		  h1 { font-size: 15px; color: #3ddad7; letter-spacing: .12em; text-transform: uppercase; }
		  .wrap { display: flex; flex-wrap: wrap; gap: 14px; }
		  .card { background: #112126; border: 1px solid #2e5053; border-radius: 10px; padding: 12px 14px; min-width: 220px; }
		  h2 { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #7f9ba1; margin: 0 0 8px; }
		  td { padding: 2px 0; }
		  td:first-child { color: #7f9ba1; padding-right: 16px; }
		  .num { text-align: right; color: #3ddad7; }
		&lt;/style&gt;
		&lt;/head&gt;
		&lt;body&gt;
		  &lt;h1&gt;Kite profiler&lt;/h1&gt;
		  &lt;div class="meta"&gt;uptime %s s&lt;/div&gt;
		  &lt;div class="wrap"&gt;
		%s
		  &lt;/div&gt;
		&lt;/body&gt;
		&lt;/html&gt;]],
				string.format("%.3f", snap.uptime),
				table.concat(cards, "\n")
			)
		end
		
		return Profiler
		</ProtectedString>

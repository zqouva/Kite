					<string name="Name">Keys</string>
					<ProtectedString name="Source">--!strict
		--[=[
			--&gt; ["Kite : Keys"]
		
			Lists. The part of a UI library that decides whether your inventory
			screen drops frames.
		
				kite.keys      reuse by identity   rows move, rows keep their state
				kite.indexes   reuse by position   rows change what they show
				kite.when      one branch on or off
				kite.switch    one branch out of many
				kite.dynamic   re-render a block when its sources change
		
			--&gt; ["why keys does not reparent"]
			Reordering by reparenting is the slowest thing you can do to a Roblox
			list. Kite writes `LayoutOrder` instead and lets the UIListLayout do
			the sorting, so a moving row costs one number, not a tree rebuild.
		
			--&gt; ["example"]
			```lua
			kite.keys(function() return items() end, function(item, index)
				return kite.create `TextButton` {
					Text = function() return item().name end,
					Activated = function() pick(index()) end,
				}
			end, function(item) return item.id end)
			```
		]=]
		
		local Util = require(script.Parent.Util)
		local Scope = require(script.Parent.Scope)
		local Graph = require(script.Parent.Graph)
		local Compiler = require(script.Parent.Compiler)
		
		local Keys = {}
		
		Keys.created = 0 :: number
		Keys.reused = 0 :: number
		Keys.destroyed = 0 :: number
		Keys.moves = 0 :: number
		
		export type Entry = {
			key: any,
			item: any,
			scope: Scope.Scope,
			instance: Instance?,
			mounted: boolean,
			order: number,
		}
		
		--&gt; ["descriptors"]
		
		function Keys.keys(source: any, render: any, keyOf: any?): any
			if type(render) ~= "function" then
				error(
					"[Kite] kite.keys(source, render) needs render to be a function.\n"
						.. "  render receives (item, index) where item is a source you call: item()\n"
						.. "  kite.help(\"keys\") shows the whole pattern.",
					2
				)
			end
		
			return {
				kind = "keys",
				source = source,
				render = render,
				keyOf = keyOf,
			}
		end
		
		function Keys.indexes(source: any, render: any): any
			return {
				kind = "keys",
				source = source,
				render = render,
				keyOf = function(_item: any, index: number)
					return index
				end,
				byIndex = true,
			}
		end
		
		function Keys.when(condition: any, element: any, fallback: any?): any
			return {
				kind = "when",
				condition = condition,
				element = element,
				fallback = fallback,
			}
		end
		
		function Keys.switch(source: any, cases: { [any]: any }, fallback: any?): any
			return {
				kind = "switch",
				source = source,
				cases = cases,
				fallback = fallback,
			}
		end
		
		function Keys.dynamic(render: any): any
			return {
				kind = "dynamic",
				render = render,
			}
		end
		
		--&gt; ["shared mount helper"]
		
		local function mountProduced(produced: any, parent: Instance, scope: Scope.Scope, instantiate: any, index: number?): Instance?
			if produced == nil then
				return nil
			end
		
			if type(produced) == "table" and (produced :: any)[1] ~= nil then
				local first: Instance? = nil
				for childIndex, child in produced do
					local made = instantiate(Compiler.plan(child), parent, scope, childIndex)
					if made and first == nil then
						first = made
					end
				end
				return first
			end
		
			return instantiate(Compiler.plan(produced), parent, scope, index)
		end
		
		Keys.mountProduced = mountProduced
		
		--&gt; ["handlers"]
		
		local function handlerForKeys(node: any, parent: Instance, scope: Scope.Scope, instantiate: any)
			local source = node.source
			local render = node.render
			local keyOf = node.keyOf
		
			local entries: { Entry } = {}
			local byKey: { [any]: Entry } = {}
			local active: { [any]: boolean } = {}
		
			Graph.effect(function()
				local list = source()
		
				if type(list) ~= "table" then
					warn(
						"[Kite] kite.keys expected a table from its source, got "
							.. `{Util.show(list)}. The list stayed the way it was.`
					)
					return
				end
		
				table.clear(active)
		
				for index, item in list do
					local key = if keyOf then keyOf(item, index) else item
		
					if key == nil then
						warn(`[Kite] key was nil at index {index}, so that row was skipped.`)
						continue
					end
		
					active[key] = true
		
					local entry = byKey[key]
		
					if entry then
						Keys.reused += 1
						entry.item(item)
					else
						local itemSource = Graph.source(item, { name = "item" })
						local entryScope = Scope.child(scope, "key")
		
						entry = {
							key = key,
							item = itemSource,
							scope = entryScope,
							instance = nil,
							mounted = false,
							order = index,
						}
		
						byKey[key] = entry
						table.insert(entries, entry)
						Keys.created += 1
					end
		
					entry.order = index
				end
		
				for index = #entries, 1, -1 do
					local entry = entries[index]
		
					if not active[entry.key] then
						Scope.destroy(entry.scope)
						byKey[entry.key] = nil
						table.remove(entries, index)
						Keys.destroyed += 1
					end
				end
		
				-- mount what is new, then settle the order with LayoutOrder
				for index, item in list do
					local key = if keyOf then keyOf(item, index) else item
					local entry = byKey[key]
		
					if entry and not entry.mounted then
						entry.mounted = true
		
						Scope.runIn(entry.scope, function()
							local produced = render(entry.item, index)
							entry.instance = mountProduced(produced, parent, entry.scope, instantiate, index)
						end)
					end
		
					if entry and entry.instance then
						local instance = entry.instance :: Instance
						if instance:IsA("GuiObject") and instance.LayoutOrder ~= entry.order then
							instance.LayoutOrder = entry.order
							Keys.moves += 1
						end
					end
				end
			end)
		
			return nil
		end
		
		local function handlerForWhen(node: any, parent: Instance, scope: Scope.Scope, instantiate: any)
			local condition = node.condition
			local element = node.element
			local fallback = node.fallback
		
			local childScope: Scope.Scope? = nil
			local mounted: any = nil
		
			Graph.effect(function()
				local value = if type(condition) == "function" then condition() else condition
				local wanted = if value then element else fallback
		
				if wanted == mounted then
					return
				end
		
				if childScope then
					Scope.destroy(childScope)
					childScope = nil
				end
		
				mounted = wanted
		
				if wanted then
					childScope = Scope.child(scope, "when")
					Scope.runIn(childScope, function()
						mountProduced(wanted, parent, childScope, instantiate, 1)
					end)
				end
			end)
		
			return nil
		end
		
		local function handlerForSwitch(node: any, parent: Instance, scope: Scope.Scope, instantiate: any)
			local source = node.source
			local cases = node.cases
			local fallback = node.fallback
		
			local childScope: Scope.Scope? = nil
			local mountedKey: any = nil
		
			Graph.effect(function()
				local value = if type(source) == "function" then source() else source
				local wanted = cases[value]
		
				if wanted == nil then
					wanted = fallback
				end
		
				local key = if wanted == nil then nil else (if type(wanted) == "table" then tostring(wanted) else wanted)
		
				if key == mountedKey then
					return
				end
		
				if childScope then
					Scope.destroy(childScope)
					childScope = nil
				end
		
				mountedKey = key
		
				if wanted then
					childScope = Scope.child(scope, "switch")
					Scope.runIn(childScope, function()
						mountProduced(wanted, parent, childScope, instantiate, 1)
					end)
				end
			end)
		
			return nil
		end
		
		local function handlerForDynamic(node: any, parent: Instance, scope: Scope.Scope, instantiate: any)
			local render = node.render
			local childScope: Scope.Scope? = nil
		
			Graph.effect(function()
				if childScope then
					Scope.destroy(childScope)
					childScope = nil
				end
		
				childScope = Scope.child(scope, "dynamic")
		
				Scope.runIn(childScope, function()
					local produced = render()
					mountProduced(produced, parent, childScope, instantiate, 1)
				end)
			end)
		
			return nil
		end
		
		--&gt; ["register"]
		-- Called once by init.luau, after Mount exists. No require cycle.
		
		function Keys.register(Mount: any)
			Mount.register("keys", handlerForKeys)
			Mount.register("indexes", handlerForKeys)
			Mount.register("when", handlerForWhen)
			Mount.register("switch", handlerForSwitch)
			Mount.register("dynamic", handlerForDynamic)
		end
		
		function Keys.stats()
			return {
				created = Keys.created,
				reused = Keys.reused,
				destroyed = Keys.destroyed,
				moves = Keys.moves,
			}
		end
		
		function Keys.reset()
			Keys.created = 0
			Keys.reused = 0
			Keys.destroyed = 0
			Keys.moves = 0
		end
		
		return Keys
		</ProtectedString>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXa180d2e2599caea8">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Lint</string>
					<ProtectedString name="Source">--!strict
		--[=[
			--&gt; ["Kite : Lint"]
		
			Three ways to read a tree before you run it.
		
				kite.strict(tree)       hard, explicit, nothing implicit
				kite.creative(tree)     shorthands allowed, structure still checked
				kite.performance(tree)  costs instead of correctness
		
			Each one hands back a report:
		
			```lua
			local report = kite.strict(tree)
			print(report:text())
			if not report:isOk() then report:print() end
			```
		
			--&gt; ["what is checked"]
			```text
			                        strict   creative   performance
			unknown property        error    error      -
			type mismatch            error    hint       -
			value range              error    error      -
			sugar                    error    hint       hint
			unkeyed list             error    warn       warn
			missing identity key     error    warn       warn
			deep tree                hint     hint       warn
			large tree               -        hint       warn
			animated layout          -        hint       warn
			dynamics per instance    -        -          hint
			respawn behaviour        hint     hint       hint
			```
		
			--&gt; ["why the messages read like this"]
			A linter that says `invalid property` teaches nothing. Every message
			here names the class, the key, what Kite expected, and the line you
			would write instead.
		]=]
		
		local Util = require(script.Parent.Util)
		local Types = require(script.Parent.Types)
		local Config = require(script.Parent.Config)
		local Compiler = require(script.Parent.Compiler)
		
		export type Diagnostic = {
			level: string,
			code: string,
			path: string,
			key: string?,
			message: string,
			hint: string?,
		}
		
		export type Report = {
			mode: string,
			diagnostics: { Diagnostic },
			instances: number,
			depth: number,
			dynamics: number,
			checked: number,
		
			errors: (Report) -&gt; { Diagnostic },
			warnings: (Report) -&gt; { Diagnostic },
			hints: (Report) -&gt; { Diagnostic },
			isOk: (Report) -&gt; boolean,
			count: (Report) -&gt; number,
			text: (Report) -&gt; string,
			print: (Report) -&gt; (),
			json: (Report) -&gt; string,
			html: (Report) -&gt; string,
		}
		
		local Lint = {}
		
		local Report = {} :: { [string]: any }
		Report.__type = "Kite.Report"
		Report.__index = Report
		
		--&gt; ["walk"]
		-- Walks the authored tree. The compiler gives you property problems; this
		-- walk gives you shape and cost problems.
		
		local function walk(node: any, path: string, depth: number, visit: (any, string, number) -&gt; ())
			if node == nil or type(node) ~= "table" then
				return
			end
		
			visit(node, path, depth)
		
			local kind = (node :: any).kind
		
			if kind == "element" then
				local props = (node :: any).props or {}
		
				for key, value in props do
					if type(key) == "number" then
						walk(value, `{path}[{key}]`, depth + 1, visit)
					elseif type(value) == "table" and (value :: any).kind == nil then
						if (value :: any)[1] ~= nil then
							for index, child in value do
								walk(child, `{path}.{key}[{index}]`, depth + 1, visit)
							end
						end
					end
				end
		
				return
			end
		
			if kind == "keys" or kind == "indexes" then
				walk(node.source, path, depth, visit)
				return
			end
		
			if kind == "when" then
				walk(node.element, `{path}.then`, depth + 1, visit)
				walk(node.fallback, `{path}.else`, depth + 1, visit)
				return
			end
		
			if kind == "switch" then
				for case, element in (node.cases or {}) do
					walk(element, `{path}.{tostring(case)}`, depth + 1, visit)
				end
				walk(node.fallback, `{path}.default`, depth + 1, visit)
				return
			end
		
			if kind == "dynamic" then
				return
			end
		
			if kind == "portal" then
				walk(node.element, path, depth + 1, visit)
				return
			end
		
			if kind == "component" then
				walk(node.props, path, depth, visit)
				return
			end
		end
		
		--&gt; ["checks"]
		
		local function checkTree(node: any, path: string, depth: number, report: Report, out: { Diagnostic }, counts: { [string]: number })
			local kind = (node :: any).kind
		
			if kind ~= "element" then
				if kind == "keys" and (node :: any).keyOf == nil and (node :: any).byIndex ~= true then
					table.insert(out, {
						level = if report.mode == "strict" then "error" else "warn",
						code = "unkeyed",
						path = path,
						key = nil,
						message = "kite.keys has no key function, so rows are matched by value",
						hint = "pass a third argument: function(item) return item.id end",
					})
				end
		
				if kind == "keys" and (node :: any).source == nil then
					table.insert(out, {
						level = "error",
						code = "keysource",
						path = path,
						key = nil,
						message = "kite.keys needs a source that returns a table",
						hint = "kite.keys(function() return rows() end, render)",
					})
				end
		
				return
			end
		
			counts.instances += 1
			if depth &gt; counts.depth then
				counts.depth = depth
			end
		
			local class = (node :: any).class
			local props = (node :: any).props or {}
		
			if type(class) ~= "string" then
				table.insert(out, {
					level = "error",
					code = "class",
					path = path,
					key = nil,
					message = "an element needs a class name string",
					hint = `kite.create "Frame" \{ ... \}`,
				})
				return
			end
		
			if not Types.known(class) then
				table.insert(out, {
					level = "hint",
					code = "unknownclass",
					path = path,
					key = nil,
					message = `Kite has never heard of "{class}"`,
					hint = `teach it once: kite.know("{class}", "Frame", ` .. [[{ YourProp = "string" })]],
				})
			end
		
			-- nameless instances are harder to debug later
			if props.Name == nil and report.mode ~= "performance" then
				table.insert(out, {
					level = "hint",
					code = "noname",
					path = path,
					key = "Name",
					message = `{class} has no Name`,
					hint = `Name = "{string.lower(class)}" makes the inspector readable`,
				})
			end
		
			-- respawn behaviour bites people once and they never forget it
			if class == "ScreenGui" and props.ResetOnSpawn == nil then
				table.insert(out, {
					level = "hint",
					code = "resetonspawn",
					path = path,
					key = "ResetOnSpawn",
					message = "ScreenGui does not say what happens on respawn",
					hint = "ResetOnSpawn = false keeps the UI alive across respawns",
				})
			end
		
			-- automatic size and a fixed size fight each other
			if props.AutomaticSize ~= nil and props.Size ~= nil then
				table.insert(out, {
					level = "hint",
					code = "autosize",
					path = path,
					key = "AutomaticSize",
					message = "AutomaticSize is set while Size is also set",
					hint = "const one axis stay zero: Size = UDim2.new(1, 0, 0, 0) with AutomaticSize = Enum.AutomaticSize.Y",
				})
			end
		
			if class == "ScrollingFrame" and props.CanvasSize == nil and props.AutomaticCanvasSize == nil then
				table.insert(out, {
					level = "warn",
					code = "canvas",
					path = path,
					key = "CanvasSize",
					message = "ScrollingFrame has no CanvasSize, so it will not scroll",
					hint = "CanvasSize = UDim2.new(0, 0, 0, 0) with AutomaticCanvasSize = Enum.AutomaticSize.Y",
				})
			end
		
			local dynamicCount = 0
			local animated = false
		
			for key, value in props do
				if type(key) == "string" and Compiler.callable(value) then
					dynamicCount += 1
		
					if (key == "Size" or key == "Position" or key == "Rotation") and report.mode == "performance" then
						table.insert(out, {
							level = "hint",
							code = "animatedlayout",
							path = path,
							key = key,
							message = `{key} changes reactively, which relayouts the subtree`,
							hint = "wrap it in kite.spring(...) so it settles, or animate Transparency and Color instead",
						})
					end
				end
		
				if key == "kite.spring" or (type(value) == "table" and (value :: any).kind == "motion") then
					animated = true
				end
			end
		
			counts.dynamics += dynamicCount
		
			if report.mode == "performance" and dynamicCount &gt; 8 then
				table.insert(out, {
					level = "hint",
					code = "manydynamics",
					path = path,
					key = nil,
					message = `{dynamicCount} reactive properties sit on one {class}`,
					hint = "Kite runs one effect per instance, so they share a pass. Split the instance if only some of them change together.",
				})
			end
		
			if animated and report.mode == "strict" then
				table.insert(out, {
					level = "hint",
					code = "strictmotion",
					path = path,
					key = nil,
					message = "this tree holds a motion",
					hint = "motions start a frame driver. strict mode is for the shape of the tree, not for motion.",
				})
			end
		end
		
		--&gt; ["inspect"]
		
		function Lint.inspect(tree: any, mode: string?, options: { maxDepth: number?, maxInstances: number? }?): Report
			local wanted = mode or Config.mode
			local opts = options or {}
		
			local previous = Config.mode
			local previousCache = Config.cache
		
			Config.apply(wanted)
			-- never const a lint pass poison the plan cache: a plan compiled under
			-- strict has no sugar in it, and mounting it later would be wrong
			Config.cache = false
		
			local collected: { Diagnostic } = {}
			local counts = { instances = 0, depth = 0, dynamics = 0 }
		
			-- property level problems come out of the compiler without a path, so
			-- they get one here before they are mixed with the shape problems
			local fromCompiler: { any } = {}
			Compiler.plan(tree, fromCompiler)
		
			for _, problem in fromCompiler do
				table.insert(collected, {
					level = problem.level or "error",
					code = problem.code or "property",
					path = problem.path or "tree",
					key = problem.key,
					message = problem.message,
					hint = problem.hint,
				})
			end
		
			-- shape and cost problems come from the walk
			walk(tree, "tree", 1, function(node, path, depth)
				checkTree(node, path, depth, { mode = wanted } :: any, collected, counts)
			end)
		
			if counts.depth &gt; (opts.maxDepth or 8) then
				table.insert(collected, {
					level = if wanted == "performance" then "warn" else "hint",
					code = "depth",
					path = "tree",
					key = nil,
					message = `the tree is {counts.depth} levels deep`,
					hint = "every level is another layout pass. flatten where you can.",
				})
			end
		
			if counts.instances &gt; (opts.maxInstances or 160) then
				table.insert(collected, {
					level = if wanted == "performance" then "warn" else "hint",
					code = "size",
					path = "tree",
					key = nil,
					message = `the tree builds {counts.instances} instances`,
					hint = "lists that long belong in kite.keys with recycling, or behind kite.when",
				})
			end
		
			if wanted == "performance" and previousCache == false then
				table.insert(collected, {
					level = "warn",
					code = "nocache",
					path = "tree",
					key = nil,
					message = "the compile cache is off",
					hint = "kite.cache(true) lets Kite reuse a plan instead of walking the tree again",
				})
			end
		
			Config.apply(previous)
			Config.cache = previousCache
		
			local report = {
				mode = wanted,
				diagnostics = collected,
				instances = counts.instances,
				depth = counts.depth,
				dynamics = counts.dynamics,
				checked = counts.instances,
			}
		
			return setmetatable(report, Report) :: any
		end
		
		function Lint.strict(tree: any, options: any?): Report
			return Lint.inspect(tree, "strict", options)
		end
		
		function Lint.creative(tree: any, options: any?): Report
			return Lint.inspect(tree, "creative", options)
		end
		
		function Lint.performance(tree: any, options: any?): Report
			return Lint.inspect(tree, "performance", options)
		end
		
		--&gt; ["report"]
		
		local LEVEL_ORDER = { error = 1, warn = 2, hint = 3 }
		
		function Report.errors(self: Report): { Diagnostic }
			local out = {}
			for _, item in self.diagnostics do
				if item.level == "error" then
					table.insert(out, item)
				end
			end
			return out
		end
		
		function Report.warnings(self: Report): { Diagnostic }
			local out = {}
			for _, item in self.diagnostics do
				if item.level == "warn" then
					table.insert(out, item)
				end
			end
			return out
		end
		
		function Report.hints(self: Report): { Diagnostic }
			local out = {}
			for _, item in self.diagnostics do
				if item.level == "hint" then
					table.insert(out, item)
				end
			end
			return out
		end
		
		function Report.isOk(self: Report): boolean
			return #self:errors() == 0
		end
		
		function Report.count(self: Report): number
			return #self.diagnostics
		end
		
		function Report.text(self: Report): string
			local lines = {}
		
			local errors = self:errors()
			local warnings = self:warnings()
			local hints = self:hints()
		
			table.insert(lines, `Kite lint : {self.mode} : {#errors} error(s), {#warnings} warning(s), {#hints} hint(s)`)
			table.insert(lines, `  tree builds {self.instances} instance(s), {self.dynamics} reactive propert(y|ies), {self.depth} level(s) deep`)
			table.insert(lines, "")
		
			local sorted = table.clone(self.diagnostics)
			table.sort(sorted, function(left, right)
				local leftLevel = LEVEL_ORDER[left.level] or 4
				local rightLevel = LEVEL_ORDER[right.level] or 4
				if leftLevel == rightLevel then
					return left.path &lt; right.path
				end
				return leftLevel &lt; rightLevel
			end)
		
			for _, item in sorted do
				table.insert(lines, `  {Util.pad(item.level, 5)} {item.code}  {item.path}{if item.key then `.{item.key}` else ""}`)
				table.insert(lines, `        {item.message}`)
				if item.hint then
					table.insert(lines, `        -&gt; {item.hint}`)
				end
			end
		
			if #sorted == 0 then
				table.insert(lines, "  clean.")
			end
		
			return table.concat(lines, "\n")
		end
		
		function Report.print(self: Report)
			print(self:text())
		end
		
		function Report.json(self: Report): string
			local parts = {}
		
			for _, item in self.diagnostics do
				local entry = string.format(
					'    { "level": "%s", "code": "%s", "path": "%s", "message": "%s"',
					item.level,
					item.code,
					item.path,
					item.message
				)
		
				if item.hint then
					entry ..= string.format(', "hint": "%s"', item.hint)
				end
		
				table.insert(parts, entry .. " }")
			end
		
			return table.concat({
				"{",
				string.format('  "mode": "%s",', self.mode),
				string.format('  "instances": %d,', self.instances),
				string.format('  "dynamics": %d,', self.dynamics),
				string.format('  "depth": %d,', self.depth),
				'  "diagnostics": [',
				table.concat(parts, ",\n"),
				"  ]",
				"}",
			}, "\n")
		end
		
		local function esc(text: string): string
			return text
				:gsub("&amp;", "&amp;amp;")
				:gsub("&lt;", "&amp;lt;")
				:gsub("&gt;", "&amp;gt;")
				:gsub('"', "&amp;quot;")
		end
		
		function Report.html(self: Report): string
			local rows = {}
		
			local sorted = table.clone(self.diagnostics)
			table.sort(sorted, function(left, right)
				return (LEVEL_ORDER[left.level] or 4) &lt; (LEVEL_ORDER[right.level] or 4)
			end)
		
			for _, item in sorted do
				table.insert(rows, string.format(
					[[      &lt;tr class="%s"&gt;
		        &lt;td class="level"&gt;%s&lt;/td&gt;
		        &lt;td class="code"&gt;%s&lt;/td&gt;
		        &lt;td class="path"&gt;%s&lt;/td&gt;
		        &lt;td class="message"&gt;%s%s&lt;/td&gt;
		      &lt;/tr&gt;]],
					item.level,
					item.level,
					esc(item.code),
					esc(item.path .. (if item.key then `.{item.key}` else "")),
					esc(item.message),
					if item.hint then `&lt;div class="hint"&gt;${esc(item.hint)}&lt;/div&gt;` else ""
				))
			end
		
			return string.format(
				[[&lt;!doctype html&gt;
		&lt;html&gt;
		&lt;head&gt;
		&lt;meta charset="utf-8"&gt;
		&lt;title&gt;Kite lint : %s&lt;/title&gt;
		&lt;style&gt;
		  body { background: #0d181b; color: #eeeeee; font: 13px/1.5 ui-monospace, monospace; margin: 24px; }
		  h1 { font-size: 15px; color: #3ddad7; letter-spacing: .12em; text-transform: uppercase; }
		  .meta { color: #7f9ba1; margin-bottom: 18px; }
		  table { border-collapse: collapse; width: 100%%; }
		  td { padding: 7px 10px; border-bottom: 1px solid #1d3339; vertical-align: top; }
		  .level { width: 58px; text-transform: uppercase; font-size: 11px; letter-spacing: .1em; }
		  .error .level { color: #f76b6e; }
		  .warn .level { color: #e8b736; }
		  .hint .level { color: #56a6e4; }
		  .code { width: 130px; color: #7f9ba1; }
		  .path { width: 260px; color: #4d6a6e; }
		  .hint { color: #6fdca0; margin-top: 3px; }
		  .clean { color: #6fdca0; }
		&lt;/style&gt;
		&lt;/head&gt;
		&lt;body&gt;
		  &lt;h1&gt;Kite lint &amp;middot; %s&lt;/h1&gt;
		  &lt;div class="meta"&gt;%d instance(s) &amp;middot; %d reactive propert(y|ies) &amp;middot; %d level(s) deep &amp;middot; %d problem(s)&lt;/div&gt;
		  &lt;table&gt;
		%s
		  &lt;/table&gt;
		&lt;/body&gt;
		&lt;/html&gt;]],
				self.mode,
				self.mode,
				self.instances,
				self.dynamics,
				self.depth,
				#self.diagnostics,
				if #rows &gt; 0 then table.concat(rows, "\n") else `      &lt;tr&gt;&lt;td class="clean"&gt;clean&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;`
			)
		end
		
		Report.__tostring = Report.text
		
		return Lint
